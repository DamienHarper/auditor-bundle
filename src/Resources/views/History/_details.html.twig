{#- Technical details of an action: every change with its raw field and values, then the transaction and the blame.
    Variables: item (HistoryItem), root (optional, "FQCN:id" of the history the action is shown in). -#}
{% import '@DHAuditor/History/_macros.html.twig' as history %}
{% set first = item.entries|first %}
<div class="mt-3 overflow-x-auto rounded-lg border border-slate-200 dark:border-slate-700">
    <table class="w-full text-left text-xs">
        <thead class="bg-slate-50 text-slate-500 dark:bg-slate-800/60 dark:text-slate-400">
            <tr>
                <th class="px-3 py-2 font-medium">{{ 'audit.history.object'|trans(domain='auditor') }}</th>
                <th class="px-3 py-2 font-medium">{{ 'audit.history.field'|trans(domain='auditor') }}</th>
                <th class="px-3 py-2 font-medium">{{ 'audit.audit_details.old_value'|trans(domain='auditor') }}</th>
                <th class="px-3 py-2 font-medium">{{ 'audit.audit_details.new_value'|trans(domain='auditor') }}</th>
            </tr>
        </thead>
        <tbody class="divide-y divide-slate-100 dark:divide-slate-800">
        {% set previous = null %}
        {% for change in item.changes %}
            {% set object = change.entity|split('\\')|last ~ ' #' ~ change.objectId %}
            <tr class="align-top">
                <td class="whitespace-nowrap px-3 py-2 text-slate-500 dark:text-slate-400">
                    {%- if object != previous -%}
                        <span class="font-medium text-slate-700 dark:text-slate-200" title="{{ change.entity }}">{{ object }}</span>
                        <span class="ml-1 font-mono">{{ change.entry.type }}</span>
                    {%- endif -%}
                </td>
                {% if change.kind.isEntityLevel() %}
                    {% set values = change.kind.value == 'deleted' ? change.old : change.new %}
                    <td class="px-3 py-2" colspan="3">
                        {% if values is iterable and values|length > 0 %}
                            <details>
                                <summary class="cursor-pointer text-slate-500 dark:text-slate-400">{{ 'audit.history.fields_count'|trans({'%count%': values|length}, 'auditor') }}</summary>
                                <dl class="mt-1 grid grid-cols-[auto_1fr] gap-x-3 gap-y-0.5">
                                    {% for field, value in values %}
                                        <dt class="text-slate-500 dark:text-slate-400">{{ dh_auditor_field_label(change.entity, field) }} <span class="font-mono">{{ field }}</span></dt>
                                        <dd>{{ history.raw(value) }}</dd>
                                    {% endfor %}
                                </dl>
                            </details>
                        {% else %}
                            <span class="text-slate-400">—</span>
                        {% endif %}
                    </td>
                {% else %}
                    <td class="whitespace-nowrap px-3 py-2">
                        {{ dh_auditor_field_label(change.entity, change.field) }}
                        <span class="ml-1 font-mono text-slate-400">{{ change.field }}</span>
                    </td>
                    {% if change.kind.value in ['added', 'removed'] %}
                        <td class="px-3 py-2 font-mono" colspan="2">
                            {{ change.kind.value == 'added' ? '+' : '−' }} {{ (change.getTargetClass() ?? '')|split('\\')|last }}#{{ change.getTargetId() }}
                            {% if (change.newLabel ?? change.oldLabel) is not null %}“{{ change.newLabel ?? change.oldLabel }}”{% endif %}
                        </td>
                    {% elseif change.kind.value == 'json' %}
                        <td class="px-3 py-2" colspan="2">{{ history.raw(change.new) }}</td>
                    {% else %}
                        {% set words = (change.old is not iterable and change.new is not iterable and ((change.old ?? '')|length > 80 or (change.new ?? '')|length > 80)) ? dh_auditor_word_diff(change.old, change.new) : null %}
                        {% if words is not null %}
                            <td class="px-3 py-2 leading-relaxed" colspan="2">
                                {%- for run in words -%}
                                    {%- if run[0] == 'delete' -%}<del class="bg-rose-100 text-rose-800 dark:bg-rose-900/40 dark:text-rose-200">{{ run[1] }}</del>
                                    {%- elseif run[0] == 'insert' -%}<ins class="bg-emerald-100 text-emerald-800 no-underline dark:bg-emerald-900/40 dark:text-emerald-200">{{ run[1] }}</ins>
                                    {%- else -%}{{ run[1] }}{%- endif -%}
                                {%- endfor -%}
                            </td>
                        {% else %}
                            <td class="px-3 py-2">{{ history.raw(change.oldLabel is not null and change.old is iterable ? change.oldLabel : change.old) }}</td>
                            <td class="px-3 py-2">{{ history.raw(change.newLabel is not null and change.new is iterable ? change.newLabel : change.new) }}</td>
                        {% endif %}
                    {% endif %}
                {% endif %}
            </tr>
            {% set previous = object %}
        {% endfor %}
        </tbody>
    </table>
</div>
<div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-[11px] text-slate-500 dark:text-slate-400">
    {% if first.transactionId %}<span>transaction {{ first.transactionId }}</span>{% endif %}
    {% if first.userId is not null %}<span>blame_id {{ first.userId }}</span>{% endif %}
    {% if first.ip %}<span>{{ first.ip }}</span>{% endif %}
    {% if first.userFirewall %}<span>{{ 'audit.history.firewall'|trans(domain='auditor') }} {{ first.userFirewall }}</span>{% endif %}
    {% if first.extraData.route is defined %}<span>route {{ first.extraData.route }}</span>{% endif %}
    <span>{{ 'audit.history.schema'|trans(domain='auditor') }} v{{ first.schemaVersion }}</span>
    {% if first.transactionId %}
        <a class="ml-auto font-sans text-xs font-medium text-indigo-600 hover:underline dark:text-indigo-400"
           href="{{ path('dh_auditor_show_transaction_stream', {hash: first.transactionId}|merge(root is defined and root ? {root: root} : {})) }}">{{ 'audit.history.all_details'|trans(domain='auditor') }}</a>
    {% endif %}
</div>
