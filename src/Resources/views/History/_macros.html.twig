{#- Pieces shared by the history templates. -#}

{#- Icon of a change: created, snapshot, deleted, edited, status, toggle, text, added, removed, json (any other name
    gets the edit icon). -#}
{% macro icon(name) -%}
    {%- set paths = {
        created: 'M12 5v14M5 12h14',
        snapshot: 'M4 7h3l2-3h6l2 3h3v12H4z M12 16a3 3 0 100-6 3 3 0 000 6z',
        deleted: 'M5 7h14M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3',
        status: 'M4 12l5 5L20 6',
        toggle: 'M7 7h10a5 5 0 010 10H7A5 5 0 017 7z M7 12a2 2 0 104 0 2 2 0 00-4 0',
        text: 'M4 6h16M4 10h16M4 14h10M4 18h7',
        added: 'M12 5v14M5 12h14',
        removed: 'M5 12h14',
        json: 'M8 4c-2 0-2 2-2 4s-2 4-2 4 2 2 2 4 0 4 2 4M16 4c2 0 2 2 2 4s2 4 2 4-2 2-2 4 0 4-2 4',
        edited: 'M4 20h4L19 9l-4-4L4 16z',
    } -%}
    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="{{ paths[name] ?? paths.edited }}"/></svg>
{%- endmacro %}

{#- Colors of the icon of a change, by its meaning: creation (green), deletion (red), a snapshot (neutral), any other
    change, links between objects included (blue). -#}
{% macro icon_tone(name) -%}
    {%- if name == 'created' -%}bg-dh-create text-dh-create-foreground
    {%- elseif name == 'deleted' -%}bg-dh-delete text-dh-delete-foreground
    {%- elseif name == 'snapshot' -%}bg-dh-muted text-dh-muted-foreground
    {%- else -%}bg-dh-update text-dh-update-foreground
    {%- endif -%}
{%- endmacro %}

{#- The sign of a link added to (+) or removed from (−) a relation. -#}
{% macro sign(added) -%}
    {%- if added -%}
        <span class="inline-flex size-4 items-center justify-center rounded-sm bg-dh-inserted font-sans font-bold text-dh-inserted-foreground">+</span>
    {%- else -%}
        <span class="inline-flex size-4 items-center justify-center rounded-sm bg-dh-deleted font-sans font-bold text-dh-deleted-foreground">−</span>
    {%- endif -%}
{%- endmacro %}

{#- Where an action came from (BlameOrigin) and in which context (via), as badges. -#}
{% macro origin(item) -%}
    {%- set via = item.via -%}
    <span class="inline-flex h-5 items-center rounded-full border border-dh-border px-2 text-[11px] font-medium text-dh-foreground"
          title="{{ ('audit.history.origin_help.' ~ item.origin.value)|trans(domain='auditor') }}">{{ ('audit.history.origin.' ~ item.origin.value)|trans(domain='auditor') }}</span>
    {%- if via is not null %}
        <span class="inline-flex h-5 items-center rounded-full border border-dashed border-dh-border px-2 text-[11px] text-dh-muted-foreground"
              {% if via.data is defined and via.data is not empty %}title="{{ via.data|json_encode }}"{% endif %}>
            {{- 'audit.entry.via'|trans(domain='auditor') }} {{ via.type }}{% if via.label is defined and via.label is not empty %} · {{ via.label }}{% endif -%}
        </span>
    {%- endif -%}
{%- endmacro %}

{#- Heading of the day of a date, in the timezone of the date (the viewer timezone): today, yesterday, or the date. -#}
{% macro day_label(date) -%}
    {%- set day = date|date('Y-m-d', false) -%}
    {%- if day == 'now'|date('Y-m-d', date.timezone) -%}
        {{ 'audit.history.today'|trans(domain='auditor') }}
    {%- elseif day == 'yesterday'|date('Y-m-d', date.timezone) -%}
        {{ 'audit.history.yesterday'|trans(domain='auditor') }}
    {%- else -%}
        {% set label = date|format_date('full', timezone: false) %}{{ label|first|upper ~ label|slice(1) }}
    {%- endif -%}
{%- endmacro %}

{#- A raw value of a diff, as JSON. -#}
{% macro raw(value) -%}
    <code class="break-words font-mono text-xs">{{ value is null ? 'null' : value|json_encode(constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES')) }}</code>
{%- endmacro %}

{#- Text deleted by a change. -#}
{% macro deleted(text) -%}
    <del class="rounded-sm bg-dh-deleted text-dh-deleted-foreground">{{ text }}</del>
{%- endmacro %}

{#- Text inserted by a change. -#}
{% macro inserted(text) -%}
    <ins class="rounded-sm bg-dh-inserted text-dh-inserted-foreground no-underline">{{ text }}</ins>
{%- endmacro %}

{#- A value of the action details, with its line breaks: a text without quotes unless they are needed to read it
    (dh_auditor_value_text()), any other value as JSON. -#}
{% macro value(value) -%}
    <code class="whitespace-pre-wrap break-words font-mono text-xs">{{ dh_auditor_value_text(value) }}</code>
{%- endmacro %}

{#- One side of an old → new change, marked as deleted or inserted; null stays unmarked. -#}
{% macro marked(value, side) -%}
    {%- if value is null -%}
        <code class="font-mono text-xs text-dh-muted-foreground">null</code>
    {%- else -%}
        {%- set shown = dh_auditor_value_text(value) -%}
        <code class="whitespace-pre-wrap break-words font-mono text-xs">{{ side == 'deleted' ? _self.deleted(shown) : _self.inserted(shown) }}</code>
    {%- endif -%}
{%- endmacro %}

{#- A change of a value, in a form that depends on the values (dh_auditor_text_change()): the changed words in place,
    the old text above the new one, or old → new. Shared by the action details and the comparison of two revisions. -#}
{% macro text_change(old, new) -%}
    {%- set text = dh_auditor_text_change(old, new) -%}
    {%- if text is not null and text.mode == 'inline' -%}
        {#- between quotes only when one of the texts needs them to be read -#}
        {%- set quote = dh_auditor_is_ambiguous_text(old) or dh_auditor_is_ambiguous_text(new) ? '"' : '' -%}
        <code class="whitespace-pre-wrap break-words font-mono text-xs">{{ quote }}
            {%- for run in text.runs -%}
                {%- if run[0] == 'delete' -%}{{ _self.deleted(run[1]) }}
                {%- elseif run[0] == 'insert' -%}{{ _self.inserted(run[1]) }}
                {%- else -%}{{ run[1] }}{%- endif -%}
            {%- endfor -%}
        {{ quote }}</code>
    {%- elseif text is not null and text.mode == 'stack' -%}
        <div class="flex flex-col gap-1">
            <code class="whitespace-pre-wrap break-words font-mono text-xs">{{ _self.deleted(dh_auditor_value_text(old)) }}</code>
            <code class="whitespace-pre-wrap break-words font-mono text-xs">{{ _self.inserted(dh_auditor_value_text(new)) }}</code>
        </div>
    {%- else -%}
        {{ _self.marked(old, 'deleted') }} <span class="text-dh-muted-foreground">→</span> {{ _self.marked(new, 'inserted') }}
    {%- endif -%}
{%- endmacro %}

{#- One side of a relation (an association diff summary), linked to the history of the object when it is viewable. The
    provider stores the identifier under the primary key name, and adds "pkName" when that name is not "id". -#}
{% macro related(summary) -%}
    {%- set id = summary.pkName is defined ? summary[summary.pkName] : summary.id -%}
    {%- if dh_auditor_is_viewable(summary.class) -%}
        <a href="{{ path('dh_auditor_show_entity_stream', {entity: summary.class|replace({'\\': '-'}), id: id}) }}" class="text-dh-link underline decoration-dh-link/40 underline-offset-2 hover:decoration-current" title="{{ summary.class }}">{{ summary.class|split('\\')|last }} #{{ id }}</a>
    {%- else -%}
        <span title="{{ summary.class }}">{{ summary.class|split('\\')|last }} #{{ id }}</span>
    {%- endif -%}
{%- endmacro %}
