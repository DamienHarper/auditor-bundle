{#- An object named by a phrase, linked to the URL of dh_auditor_object_url() when the reader may see it, and marked
    when it no longer exists (dh_auditor_is_deleted(), for the references a page checked), unless the phrase itself
    tells its deletion. -#}
{%- set url = dh_auditor_object_url(reference) -%}
<strong class="font-medium">
    {%- if url and url.visible -%}
        <a href="{{ url.url }}" class="text-dh-link underline decoration-dh-link/40 underline-offset-2 hover:decoration-current">{{ reference.label }}</a>
    {%- else -%}
        {{- reference.label -}}
    {%- endif -%}
</strong>
{%- if not reference.deletedByThePhrase and dh_auditor_is_deleted(reference) %} <span class="text-dh-muted-foreground">{{ 'audit.history.deleted'|trans(domain='auditor') }}</span>{% endif -%}