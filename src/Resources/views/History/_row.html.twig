{#- One action of a history: icon, author, what it was done on (context), phrase, time, origin, and its technical
    details. Variables: row ({item, phrase, context}), root (optional "FQCN:id"), date_format ("time" in a list grouped
    by day, "datetime" otherwise), shorten (optional: number of fragments kept), details (false to leave them out),
    show_author (false on the page of the author). -#}
{% import '@DHAuditor/History/_macros.html.twig' as history %}
{% set item = row.item %}
{% set transaction = (item.entries|first).transactionId %}
{% set transaction_url = transaction ? dh_auditor_transaction_url(transaction, root: root ?? null) : null %}
{#- The whole row leads to the action: the link of its time stretches over the row (::after), the links it names, its
    origin badges and its details sit above that layer. -#}
<li class="relative -mx-2 flex gap-3 rounded-lg px-2 py-3{{ transaction_url ? ' hover:bg-dh-accent/50' : '' }}" data-dh-auditor-action="{{ item.key }}" data-dh-auditor-entities="{{ item.getEntities()|join(' ') }}">
    <span class="mt-0.5 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-dh-muted text-dh-muted-foreground">
        {{- history.icon(row.phrase.icon) -}}
    </span>
    <div class="min-w-0 flex-1">
        <p class="text-sm leading-relaxed [&_a]:relative [&_a]:z-10{{ (show_author ?? true) ? '' : ' first-letter:uppercase' }}">
            {% if show_author ?? true -%}
                {% set user_url = item.userId is same as(null) ? null : dh_auditor_user_url(item.userId) %}
                {%- if user_url -%}
                    <a href="{{ user_url }}" class="font-semibold hover:underline">{{ item|dh_auditor_author }}</a>
                {%- else -%}
                    <span class="font-semibold">{{ item|dh_auditor_author }}</span>
                {%- endif %}
            {%- endif %}
            {% if row.context %}<span>{{ row.context|dh_auditor_phrase }}{{ 'audit.history.context_separator'|trans(domain='auditor') }}</span>{% endif %}
            {% if shorten is defined and shorten %}
                <span>{{ row.phrase|dh_auditor_shorten(shorten)|dh_auditor_phrase }}</span>
            {% else %}
                <span class="hidden sm:inline">{{ row.phrase|dh_auditor_phrase }}</span>
                <span class="sm:hidden">{{ row.phrase|dh_auditor_shorten(3)|dh_auditor_phrase }}</span>
            {% endif %}
        </p>
        {#- Time, origin and the details toggle on one line, which wraps between them; opened, the details take the
            whole width below. -#}
        <div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-dh-muted-foreground">
            {% set full_date = item.createdAt|format_datetime('full', 'medium', timezone: false) %}
            {% set time -%}
                <time datetime="{{ item.createdAt|date('c') }}" title="{{ full_date }}">
                    {%- if (date_format ?? 'time') == 'time' -%}
                        {{ item.createdAt|format_time('short', timezone: false) }}
                    {%- else -%}
                        {{ item.createdAt|format_datetime('medium', 'short', timezone: false) }}
                    {%- endif -%}
                </time>
            {%- endset %}
            {% if transaction_url %}
                <a href="{{ transaction_url }}"
                   aria-label="{{ 'audit.action.title'|trans({'%date%': full_date}, 'auditor') }}"
                   class="whitespace-nowrap underline decoration-dh-muted-foreground/50 underline-offset-2 hover:text-dh-foreground hover:decoration-current focus-visible:outline-none after:absolute after:inset-0 after:rounded-lg focus-visible:after:ring-2 focus-visible:after:ring-dh-ring">{{ time }}</a>
            {% else %}
                <span class="whitespace-nowrap">{{ time }}</span>
            {% endif %}
            <span class="contents [&>span]:relative [&>span]:z-10">{{ history.origin(item) }}</span>
            {% if details ?? true %}
            <details class="group relative z-10 open:basis-full" data-dh-auditor-details>
                <summary class="inline-flex cursor-pointer list-none items-center gap-1 font-medium text-dh-muted-foreground hover:text-dh-foreground [&::-webkit-details-marker]:hidden">
                    <svg class="h-3 w-3 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                    <span class="group-open:hidden">{{ 'audit.history.details'|trans(domain='auditor') }}</span>
                    <span class="hidden group-open:inline">{{ 'audit.history.hide_details'|trans(domain='auditor') }}</span>
                </summary>
                {{ include('@DHAuditor/History/_details.html.twig', {item: item, root: root ?? null}, with_context = false) }}
            </details>
            {% endif %}
        </div>
    </div>
</li>
