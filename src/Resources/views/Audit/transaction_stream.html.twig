{% extends '@DHAuditor/layout.html.twig' %}
{% import '@DHAuditor/History/_macros.html.twig' as history %}

{% set item = row.item %}
{% set first = item.entries|first %}

{% block title %}{{ 'audit.action.title'|trans({'%date%': item.createdAt|format_datetime('medium', 'short', timezone: false)}, 'auditor') }} · auditor{% endblock %}

{% block dh_auditor_content %}
    <nav class="mb-3 text-sm text-slate-500 dark:text-slate-400" aria-label="breadcrumb">
        <a href="{{ path('dh_auditor_list_audits') }}" class="hover:underline">{{ 'audit.header.home'|trans(domain='auditor') }}</a>
        {% if root %}
            <span class="mx-1">/</span>
            <a href="{{ path('dh_auditor_show_entity_stream', {entity: root.class|replace({'\\': '-'}), id: root.id}) }}" class="hover:underline">{{ dh_auditor_entity_name(root.class) }} #{{ root.id }}</a>
        {% endif %}
        <span class="mx-1">/</span>
        <span>{{ 'audit.action.title'|trans({'%date%': item.createdAt|format_datetime('medium', 'short', timezone: false)}, 'auditor') }}</span>
    </nav>

    <div class="flex flex-wrap items-start justify-between gap-4">
        <div class="min-w-0">
            <h1 class="text-xl font-semibold leading-snug">
                {{ item|dh_auditor_author }}
                {% if row.context %}{{ row.context|dh_auditor_phrase }}{{ 'audit.history.context_separator'|trans(domain='auditor') }}{% endif %}
                {{ row.phrase|dh_auditor_shorten(1)|dh_auditor_phrase }}
            </h1>
            <p class="mt-1 flex flex-wrap items-center gap-2 text-sm text-slate-500 dark:text-slate-400">
                <time datetime="{{ item.createdAt|date('c') }}">{% set full_date = item.createdAt|format_datetime('full', 'short', timezone: false) %}{{ full_date|first|upper ~ full_date|slice(1) }}</time>
                {{ history.origin(item) }}
                <span>· {{ 'audit.action.objects'|trans({'%count%': objects}, 'auditor') }}</span>
            </p>
        </div>
        {% if root %}
            <div class="flex gap-2 text-sm">
                {% if neighbours.older %}
                    <a href="{{ path('dh_auditor_show_transaction_stream', {hash: neighbours.older, root: root.param}) }}" class="rounded-lg border border-slate-300 px-3 py-1.5 hover:bg-slate-100 dark:border-slate-600 dark:hover:bg-slate-800" rel="prev">{{ 'audit.action.previous'|trans(domain='auditor') }}</a>
                {% endif %}
                {% if neighbours.newer %}
                    <a href="{{ path('dh_auditor_show_transaction_stream', {hash: neighbours.newer, root: root.param}) }}" class="rounded-lg border border-slate-300 px-3 py-1.5 hover:bg-slate-100 dark:border-slate-600 dark:hover:bg-slate-800" rel="next">{{ 'audit.action.next'|trans(domain='auditor') }}</a>
                {% endif %}
            </div>
        {% endif %}
    </div>

    <ul class="mt-6 space-y-2">
        {% for fragment in row.phrase.fragments %}
            <li class="flex gap-3 text-sm">
                <span class="mt-0.5 inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-slate-200 bg-slate-100 text-slate-600 dark:border-slate-700 dark:bg-slate-800 dark:text-slate-300">{{ history.icon(fragment.icon) }}</span>
                <span class="pt-0.5">{{ fragment|dh_auditor_phrase }}</span>
            </li>
        {% endfor %}
    </ul>

    <section class="mt-8">
        <h2 class="text-sm font-semibold">{{ 'audit.action.technical'|trans(domain='auditor') }}</h2>
        <div class="mt-2 overflow-x-auto rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900">
            {#- Fixed column widths: the old and new values get the same room, whatever their length -#}
            <table class="w-full min-w-[48rem] table-fixed text-left text-xs text-slate-700 dark:text-slate-200">
                <colgroup>
                    <col class="w-[14%]">
                    <col class="w-[9%]">
                    <col class="w-[13%]">
                    <col class="w-[14%]">
                    <col class="w-1/4">
                    <col class="w-1/4">
                </colgroup>
                <thead class="bg-slate-50 text-slate-500 dark:bg-slate-800/60 dark:text-slate-400">
                    <tr>
                        <th class="px-3 py-2 font-medium">{{ 'audit.action.table'|trans(domain='auditor') }}</th>
                        <th class="px-3 py-2 font-medium">{{ 'audit.action.type'|trans(domain='auditor') }}</th>
                        <th class="px-3 py-2 font-medium">{{ 'audit.history.object'|trans(domain='auditor') }}</th>
                        <th class="px-3 py-2 font-medium">{{ 'audit.action.raw_field'|trans(domain='auditor') }}</th>
                        <th class="px-3 py-2 font-medium">old</th>
                        <th class="px-3 py-2 font-medium">new</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 align-top dark:divide-slate-800">
                    {% for written in entries %}
                        {% set entry = written.entry %}
                        {% set diffs = entry.diffs %}
                        {% set object = written.entity|split('\\')|last ~ ' #' ~ entry.objectId %}
                        {% if entry.type in ['associate', 'dissociate'] %}
                            <tr>
                                <td class="break-words px-3 py-2 font-mono">{{ tables[written.entity] }} · {{ entry.id }}</td>
                                <td class="px-3 py-2 font-mono">{{ entry.type }}</td>
                                <td class="break-words px-3 py-2" title="{{ written.entity }}">{{ object }}</td>
                                <td class="break-words px-3 py-2 font-mono">{{ diffs.source.field ?? '' }}</td>
                                <td class="px-3 py-2" colspan="2">{{ history.raw(diffs.target ?? null) }}</td>
                            </tr>
                        {% else %}
                            {% for field, diff in diffs %}
                                <tr>
                                    <td class="break-words px-3 py-2 font-mono">{% if loop.first %}{{ tables[written.entity] }} · {{ entry.id }}{% endif %}</td>
                                    <td class="px-3 py-2 font-mono">{% if loop.first %}{{ entry.type }}{% endif %}</td>
                                    <td class="break-words px-3 py-2" title="{{ written.entity }}">{% if loop.first %}{{ object }}{% endif %}</td>
                                    <td class="break-words px-3 py-2 font-mono">{{ field }}{% if entry.isDeepDiff(field) %} <span class="text-slate-400">(deep diff)</span>{% endif %}</td>
                                    {% if entry.isDeepDiff(field) %}
                                        <td class="px-3 py-2" colspan="2">{{ history.raw(diff) }}</td>
                                    {% else %}
                                        <td class="px-3 py-2">{{ history.raw(diff.old ?? null) }}</td>
                                        <td class="px-3 py-2">{{ history.raw(diff.new ?? null) }}</td>
                                    {% endif %}
                                </tr>
                            {% else %}
                                <tr>
                                    <td class="break-words px-3 py-2 font-mono">{{ tables[written.entity] }} · {{ entry.id }}</td>
                                    <td class="px-3 py-2 font-mono">{{ entry.type }}</td>
                                    <td class="break-words px-3 py-2" title="{{ written.entity }}">{{ object }}</td>
                                    <td class="px-3 py-2 text-slate-400" colspan="3">—</td>
                                </tr>
                            {% endfor %}
                        {% endif %}
                    {% endfor %}
                </tbody>
            </table>
        </div>
        {% if entryCount > entries|length %}
            <p class="mt-2 text-xs text-slate-500 dark:text-slate-400">{{ 'audit.action.more_entries'|trans({'%count%': entryCount - entries|length}, 'auditor') }}</p>
        {% endif %}

        <dl class="mt-4 grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 rounded-xl border border-slate-200 bg-white p-4 text-xs dark:border-slate-800 dark:bg-slate-900">
            <dt class="text-slate-500 dark:text-slate-400">transaction_id</dt><dd class="break-all font-mono">{{ hash }}</dd>
            {% if ulidDate %}<dt class="text-slate-500 dark:text-slate-400">{{ 'audit.action.ulid_date'|trans(domain='auditor') }}</dt><dd class="font-mono">{{ ulidDate|format_datetime('medium', 'medium', timezone: false) }}</dd>{% endif %}
            <dt class="text-slate-500 dark:text-slate-400">blame_id</dt><dd class="font-mono">{{ first.userId ?? '—' }}</dd>
            <dt class="text-slate-500 dark:text-slate-400">user_fqdn</dt><dd class="break-all font-mono">{{ first.userFqdn ?? '—' }}</dd>
            <dt class="text-slate-500 dark:text-slate-400">{{ 'audit.history.firewall'|trans(domain='auditor') }}</dt><dd class="font-mono">{{ first.userFirewall ?? '—' }}</dd>
            <dt class="text-slate-500 dark:text-slate-400">IP</dt><dd class="font-mono">{{ first.ip ?? '—' }}</dd>
            <dt class="text-slate-500 dark:text-slate-400">via</dt><dd class="font-mono">{{ first.via is not null ? (first.via.type ~ (first.via.label is defined ? ' · ' ~ first.via.label : '')) : 'audit.action.no_via'|trans(domain='auditor') }}</dd>
            <dt class="text-slate-500 dark:text-slate-400">schema_version</dt><dd class="font-mono">{{ first.schemaVersion }}</dd>
            {% if first.extraData is not empty %}<dt class="text-slate-500 dark:text-slate-400">extra_data</dt><dd>{{ history.raw(first.extraData) }}</dd>{% endif %}
            <dt class="text-slate-500 dark:text-slate-400">{{ 'audit.history.entries'|trans(domain='auditor') }}</dt><dd>{{ 'audit.history.entries_count'|trans({'%count%': entryCount}, 'auditor') }} · {{ 'audit.action.tables'|trans({'%count%': tables|length}, 'auditor') }}</dd>
        </dl>

        <div class="mt-4 space-y-2">
            {% for written in entries %}
                {% set entry = written.entry %}
                <details class="rounded-xl border border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-900">
                    <summary class="flex cursor-pointer items-center justify-between gap-2 px-4 py-2 font-mono text-xs">
                        <span>{{ tables[written.entity] }} · {{ entry.id }} · diffs</span>
                        <button type="button" class="font-sans font-medium text-indigo-600 hover:underline dark:text-indigo-400" data-dh-auditor-copy="dh-auditor-json-{{ loop.index }}" data-dh-auditor-copied="{{ 'audit.history.copied'|trans(domain='auditor') }}" data-dh-auditor-copy-failed="{{ 'audit.history.copy_failed'|trans(domain='auditor') }}">{{ 'audit.history.copy'|trans(domain='auditor') }}</button>
                    </summary>
                    <pre id="dh-auditor-json-{{ loop.index }}" class="overflow-x-auto rounded-b-xl bg-slate-900 p-4 text-xs leading-relaxed text-slate-100">{{ {diffs: entry.diffs, blame: entry.blame}|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_UNESCAPED_SLASHES')) }}</pre>
                </details>
            {% endfor %}
        </div>
    </section>
{% endblock %}
