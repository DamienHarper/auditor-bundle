{% extends "@DHAuditor/layout.html.twig" %}

{% import '@DHAuditor/Audit/helpers/helper.html.twig' as helper %}
{% import '@DHAuditor/Audit/helpers/pager.html.twig' as pager %}

{% block dh_auditor_content %}
    {% set entity_param = helper.namespaceToParam(entity) %}
    {% set route_params = {entity: entity_param, id: id} %}
    {% if selected is not null %}
        {% set route_params = route_params|merge({selected: selected.id}) %}
    {% endif %}

    {% block dh_auditor_header %}
    <div class="sticky top-16 z-40 -mx-6 px-6 py-3 mb-4 bg-slate-50/80 dark:bg-slate-950/80 backdrop-blur">
        {# Back link #}
        <a href="{{ path('dh_auditor_show_entity_stream', {entity: entity_param, id: id}) }}"
           class="inline-flex items-center text-sm text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200 mb-3">
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
            {{ entity|split('\\')|last }} #{{ id }}
        </a>

        <div>
            <h1 class="text-lg font-semibold text-slate-900 dark:text-slate-100" title="{{ entity }}">
                {{ 'audit.revisions.title'|trans(domain='auditor') }}
            </h1>
            <p class="text-sm text-slate-500 dark:text-slate-400">
                {% if selected is null %}
                    {{ 'audit.revisions.pick_first'|trans(domain='auditor') }}
                {% else %}
                    {{ 'audit.revisions.pick_second'|trans(domain='auditor') }}
                    <a href="{{ path('dh_auditor_select_revisions', {entity: entity_param, id: id}) }}"
                       class="ml-1 text-indigo-600 dark:text-indigo-400 hover:underline">
                        {{ 'audit.revisions.change_selection'|trans(domain='auditor') }}
                    </a>
                {% endif %}
            </p>
        </div>
    </div>
    {% endblock dh_auditor_header %}

    <ul class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 divide-y divide-slate-200 dark:divide-slate-800">
        {% for entry in paginator.results %}
            {% set is_selected = selected is not null and selected.id == entry.id %}
            {% set row_content %}
                <span class="flex items-center gap-3 min-w-0">
                    <span class="w-24 shrink-0">{{ helper.type_badge(entry.type) }}</span>
                    <span class="text-sm text-slate-900 dark:text-slate-100 truncate">{{ entry.createdAt|format_datetime('full', 'short') }}</span>
                    {% if is_selected %}
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-indigo-100 text-indigo-700 dark:bg-indigo-900/40 dark:text-indigo-300">
                            {{ 'audit.revisions.selected'|trans(domain='auditor') }}
                        </span>
                    {% endif %}
                </span>
                <span class="text-xs text-slate-500 dark:text-slate-400 shrink-0">
                    {{ 'audit.entry.by'|trans(domain='auditor') }}
                    {{ entry.username ?? 'audit.audit_details.anonymous'|trans(domain='auditor') }}
                </span>
            {% endset %}
            <li>
                {% if is_selected %}
                    <div class="flex items-center justify-between gap-4 px-4 py-3 bg-indigo-50 dark:bg-indigo-900/20" aria-current="true">
                        {{ row_content }}
                    </div>
                {% else %}
                    <a href="{{ selected is null
                            ? path('dh_auditor_select_revisions', {entity: entity_param, id: id, selected: entry.id, page: paginator.currentPage})
                            : path('dh_auditor_compare_revisions', {entity: entity_param, id: id, from: selected.id, to: entry.id}) }}"
                       class="flex items-center justify-between gap-4 px-4 py-3 hover:bg-slate-50 dark:hover:bg-slate-800/50 focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-indigo-500 transition">
                        {{ row_content }}
                    </a>
                {% endif %}
            </li>
        {% else %}
            <li class="p-8 text-center text-slate-500 dark:text-slate-400">
                {{ 'audit.stream.no_entries'|trans(domain='auditor') }}
            </li>
        {% endfor %}
    </ul>

    {% block dh_auditor_pager %}
        {{ pager.render_route('dh_auditor_select_revisions', route_params, paginator) }}
    {% endblock dh_auditor_pager %}
{% endblock dh_auditor_content %}
