{% extends "@DHAuditor/layout.html.twig" %}

{% import '@DHAuditor/Audit/helpers/helper.html.twig' as helper %}

{% block dh_auditor_content %}
    {% block dh_auditor_header %}
    <div class="sticky top-16 z-40 -mx-6 px-6 py-3 mb-4 bg-slate-50/80 dark:bg-slate-950/80 backdrop-blur">
        {# Back link #}
        <a href="{{ path('dh_auditor_show_entity_stream', {entity: helper.namespaceToParam(entity), id: id}) }}"
           class="inline-flex items-center text-sm text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200 mb-3">
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
            {{ entity|split('\\')|last }} #{{ id }}
        </a>

        <div>
            <h1 class="text-lg font-semibold text-slate-900 dark:text-slate-100" title="{{ entity }}">
                {{ 'audit.revisions.title'|trans(domain='auditor') }}
            </h1>
            <p class="text-sm text-slate-500 dark:text-slate-400">
                {{ 'audit.revisions.hint'|trans(domain='auditor') }}
            </p>
        </div>
    </div>
    {% endblock dh_auditor_header %}

    <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 divide-y divide-slate-200 dark:divide-slate-800">
        {% for entry in entries %}
            {% set isSelected = selected is not null and selected == entry.id %}
            <div class="flex items-center justify-between gap-4 px-4 py-3 transition{% if isSelected %} bg-indigo-50 dark:bg-indigo-900/20{% else %} cursor-pointer hover:bg-slate-50 dark:hover:bg-slate-800/50{% endif %}"
                 {% if not isSelected %}onclick="compareWith('{{ entry.id }}')"{% endif %}>
                <div class="flex items-center gap-3 min-w-0">
                    <span class="w-24 shrink-0">
                        {{ helper.type_badge(entry.type) }}
                    </span>
                    <span class="text-sm text-slate-900 dark:text-slate-100 truncate">
                        {{ entry.createdAt|format_datetime('full', 'short') }}
                    </span>
                </div>
                <span class="text-xs text-slate-500 dark:text-slate-400 shrink-0">
                    {{ 'audit.entry.by'|trans(domain='auditor') }}
                    {{ entry.username ?? 'audit.audit_details.anonymous'|trans(domain='auditor') }}
                </span>
            </div>
        {% else %}
            <div class="p-8 text-center text-slate-500 dark:text-slate-400">
                {{ 'audit.stream.no_entries'|trans(domain='auditor') }}
            </div>
        {% endfor %}
    </div>

    <script>
        const compareBaseUrl = {{ path('dh_auditor_compare_revisions', {entity: helper.namespaceToParam(entity), id: id})|json_encode|raw }};
        const selectedRevision = {{ selected is not null ? selected|json_encode|raw : 'null' }};

        function compareWith(id) {
            const url = new URL(compareBaseUrl, window.location.origin);
            url.searchParams.set('from', selectedRevision);
            url.searchParams.set('to', id);
            window.location.href = url.toString();
        }
    </script>
{% endblock dh_auditor_content %}
