{% extends "@DHAuditor/layout.html.twig" %}

{% import '@DHAuditor/Audit/helpers/helper.html.twig' as helper %}
{% import '@DHAuditor/Audit/helpers/pager.html.twig' as pager %}

{% block dh_auditor_content %}
{#- Root of the viewer content: bounds the reset of viewer.css, for a layout that extends the one of the application -#}
<div data-dh-auditor-viewer>
    {% set entity_param = helper.namespaceToParam(entity) %}
    {% set route_params = {entity: entity_param, id: id} %}
    {% if selected is not null %}
        {% set route_params = route_params|merge({selected: selected.id}) %}
    {% endif %}

    {% block dh_auditor_header %}
    <div class="dh:-mx-4 dh:px-4 dh:sm:-mx-6 dh:sm:px-6 dh:sm:sticky dh:sm:top-16 dh:sm:z-40 dh:py-3 dh:mb-4 dh:bg-dh-background/80 dh:backdrop-blur">
        {# Back link #}
        <a href="{{ path('dh_auditor_show_entity_stream', {entity: entity_param, id: id}) }}"
           class="dh:inline-flex dh:items-center dh:text-sm dh:text-dh-muted-foreground dh:hover:text-dh-foreground dh:mb-3">
            <svg class="dh:w-4 dh:h-4 dh:mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
            {{ entity|split('\\')|last }} #{{ id }}
        </a>

        <div>
            <h1 class="dh:text-2xl dh:font-semibold dh:tracking-tight dh:text-dh-foreground" title="{{ entity }}">
                {{ 'audit.revisions.title'|trans(domain='auditor') }}
            </h1>
            <p class="dh:text-sm dh:text-dh-muted-foreground">
                {% if selected is null %}
                    {{ 'audit.revisions.pick_first'|trans(domain='auditor') }}
                {% else %}
                    {{ 'audit.revisions.pick_second'|trans(domain='auditor') }}
                    <a href="{{ path('dh_auditor_select_revisions', {entity: entity_param, id: id}) }}"
                       class="dh:ml-1 dh:font-medium dh:text-dh-link dh:underline dh:underline-offset-4 dh:hover:decoration-2">
                        {{ 'audit.revisions.change_selection'|trans(domain='auditor') }}
                    </a>
                {% endif %}
            </p>
        </div>
    </div>
    {% endblock dh_auditor_header %}

    <ul class="dh:rounded-xl dh:border dh:border-dh-border dh:bg-dh-card dh:divide-y dh:divide-dh-border">
        {% for entry in paginator.results %}
            {% set is_selected = selected is not null and selected.id == entry.id %}
            {% set row_content %}
                <span class="dh:flex dh:items-center dh:gap-3 dh:min-w-0">
                    {% set revision = dh_auditor_history_item(entry) %}
                    <span class="dh:flex dh:min-w-0 dh:flex-col">
                        <span class="dh:truncate dh:text-sm dh:text-dh-foreground">{{ revision|dh_auditor_author }} {{ revision|dh_auditor_phrase_text }}</span>
                        <span class="dh:text-xs dh:text-dh-muted-foreground">{{ entry.createdAt|format_datetime('full', 'short', timezone: false) }}</span>
                    </span>
                    {% if is_selected %}
                        <span class="dh:inline-flex dh:h-5 dh:items-center dh:rounded-full dh:border dh:border-dh-border dh:px-2 dh:text-xs dh:font-medium dh:text-dh-foreground">
                            {{ 'audit.revisions.selected'|trans(domain='auditor') }}
                        </span>
                    {% endif %}
                </span>
                <span class="dh:text-xs dh:text-dh-muted-foreground dh:shrink-0">
                    {{ helper.via(entry) }}
                </span>
            {% endset %}
            <li>
                {% if is_selected %}
                    <div class="dh:flex dh:items-center dh:justify-between dh:gap-4 dh:border-l-2 dh:border-l-dh-brand dh:py-3 dh:pl-3.5 dh:pr-4 dh:bg-dh-accent" aria-current="true">
                        {{ row_content }}
                    </div>
                {% else %}
                    <a href="{{ selected is null
                            ? path('dh_auditor_select_revisions', {entity: entity_param, id: id, selected: entry.id, page: paginator.currentPage})
                            : path('dh_auditor_compare_revisions', {entity: entity_param, id: id, from: selected.id, to: entry.id}) }}"
                       class="dh:flex dh:items-center dh:justify-between dh:gap-4 dh:px-4 dh:py-3 dh:hover:bg-dh-accent/50 dh:focus:outline-none dh:focus-visible:ring-2 dh:focus-visible:ring-inset dh:focus-visible:ring-dh-ring dh:transition">
                        {{ row_content }}
                    </a>
                {% endif %}
            </li>
        {% else %}
            <li class="dh:p-8 dh:text-center dh:text-dh-muted-foreground">
                {{ 'audit.stream.no_entries'|trans(domain='auditor') }}
            </li>
        {% endfor %}
    </ul>

    {% block dh_auditor_pager %}
        {{ pager.render_route('dh_auditor_select_revisions', route_params, paginator) }}
    {% endblock dh_auditor_pager %}
</div>
{% endblock dh_auditor_content %}
