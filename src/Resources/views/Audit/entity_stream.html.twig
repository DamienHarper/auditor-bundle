{% extends "@DHAuditor/layout.html.twig" %}

{% import '@DHAuditor/Audit/helpers/helper.html.twig' as helper %}
{% import '@DHAuditor/Audit/helpers/pager.html.twig' as pager %}

{% set id = null %}

{% block dh_auditor_content %}
    {# Sub-header - sticky with back link #}
    {% block dh_auditor_header %}
    <div class="dh:-mx-4 dh:px-4 dh:sm:-mx-6 dh:sm:px-6 dh:sm:sticky dh:sm:top-16 dh:sm:z-40 dh:py-3 dh:mb-4 dh:bg-dh-background/80 dh:backdrop-blur">
        {# Back link #}
        <a href="{{ path('dh_auditor_list_audits') }}"
           class="dh:inline-flex dh:items-center dh:text-sm dh:text-dh-muted-foreground dh:hover:text-dh-foreground dh:mb-3">
            <svg class="dh:w-4 dh:h-4 dh:mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
            {{ 'audit.header.back_to_entities'|trans(domain='auditor') }}
        </a>

        <div class="dh:flex dh:flex-col dh:sm:flex-row dh:sm:items-center dh:sm:justify-between">
            <div>
                <h1 class="dh:text-2xl dh:font-semibold dh:tracking-tight dh:text-dh-foreground" title="{{ entity }}">
                    {{ dh_auditor_entity_name(entity, 2) }}
                </h1>
                <p class="dh:text-sm dh:text-dh-muted-foreground">
                    {{ 'audit.history.actions_count'|trans({'%count%': paginator.numResults}, 'auditor') }}
                    · {{ 'audit.audit_details.most_recent'|trans(domain='auditor') }}
                </p>
            </div>
            <form method="get" action="{{ path('dh_auditor_show_entity_stream', {entity: helper.namespaceToParam(entity), id: id}) }}"
                  class="dh:mt-3 dh:grid dh:grid-cols-2 dh:gap-2 dh:sm:mt-0 dh:sm:flex dh:sm:flex-wrap dh:sm:items-center">
                {# Type filter #}
                <select id="filter-type" name="type" aria-label="{{ 'audit.history.filter.what'|trans(domain='auditor') }}"
                        class="dh-auditor-control dh:col-span-2"
                        data-dh-auditor-autosubmit>
                    <option value="">{{ 'audit.history.filter.option'|trans({'%filter%': 'audit.history.filter.what'|trans(domain='auditor'), '%value%': 'audit.history.filter.everything'|trans(domain='auditor')}, 'auditor') }}</option>
                    {% for type in filterOptions.types %}
                        <option value="{{ type }}" {% if filters.type == type %}selected{% endif %}>
                            {{ ('audit.filter.type.' ~ type)|trans(domain='auditor') }}
                        </option>
                    {% endfor %}
                </select>

                {# User filter #}
                <select id="filter-user" name="user" aria-label="{{ 'audit.history.filter.who'|trans(domain='auditor') }}"
                        class="dh-auditor-control dh:col-span-2"
                        data-dh-auditor-autosubmit>
                    <option value="">{{ 'audit.history.filter.option'|trans({'%filter%': 'audit.history.filter.who'|trans(domain='auditor'), '%value%': 'audit.history.filter.everyone'|trans(domain='auditor')}, 'auditor') }}</option>
                    {% if filterOptions.hasAnonymous %}
                        <option value="__anonymous__" {% if filters.user == '__anonymous__' %}selected{% endif %}>
                            {{ 'audit.filter.anonymous'|trans(domain='auditor') }}
                        </option>
                    {% endif %}
                    {% for user in filterOptions.users %}
                        <option value="{{ user.id }}" {% if filters.user == user.id %}selected{% endif %}>
                            {{ user.name }}
                        </option>
                    {% endfor %}
                </select>

                {# Changed field filter #}
                {% if filterOptions.fields|length > 0 %}
                    <select id="filter-field" name="field" aria-label="{{ 'audit.history.field'|trans(domain='auditor') }}"
                            class="dh-auditor-control dh:col-span-2"
                            data-dh-auditor-autosubmit>
                        <option value="">{{ 'audit.history.filter.option'|trans({'%filter%': 'audit.history.field'|trans(domain='auditor'), '%value%': 'audit.history.filter.all_fields'|trans(domain='auditor')}, 'auditor') }}</option>
                        {% for field in filterOptions.fields %}
                            <option value="{{ field }}" {% if filters.field == field %}selected{% endif %}>
                                {{ dh_auditor_field_label(entity, field) }}
                            </option>
                        {% endfor %}
                    </select>
                {% endif %}
                {% for name, label in {'date_from': 'from', 'date_to': 'to'} %}
                    <label class="dh:flex dh:flex-col dh:gap-1 dh:text-xs dh:text-dh-muted-foreground dh:sm:flex-row dh:sm:items-center dh:sm:gap-1.5" for="filter-{{ name }}">
                        {{ ('audit.filter.' ~ label)|trans(domain='auditor') }}
                        <input type="date" id="filter-{{ name }}" name="{{ name }}" value="{{ filters[name] }}" class="dh-auditor-control dh:w-full dh:sm:w-auto">
                    </label>
                {% endfor %}
                <button type="submit" class="dh-auditor-control dh-auditor-control-primary dh:col-span-2">
                    {{ 'audit.filter.apply'|trans(domain='auditor') }}
                </button>
                {% if filters.date_from or filters.date_to %}
                    <a href="{{ path('dh_auditor_show_entity_stream', {entity: helper.namespaceToParam(entity), id: id, type: filters.type, user: filters.user, field: filters.field}) }}"
                       class="dh:col-span-2 dh:inline-flex dh:h-8 dh:items-center dh:px-2 dh:text-sm dh:text-dh-link dh:underline dh:underline-offset-4 dh:hover:decoration-2">
                        {{ 'audit.filter.clear_period'|trans(domain='auditor') }}
                    </a>
                {% endif %}
            </form>
        </div>
    </div>
    {% endblock dh_auditor_header %}

    {# Actions of the page #}
    <section data-dh-auditor-actions>
        <label class="dh:inline-flex dh:items-center dh:gap-1.5 dh:text-sm dh:text-dh-muted-foreground">
            <input type="checkbox" class="dh:size-4 dh:accent-dh-primary" data-dh-auditor-expand-all>
            {{ 'audit.history.expand_all'|trans(domain='auditor') }}
        </label>
        {{ include('@DHAuditor/History/_actions.html.twig', {rows: rows, more: null}, with_context = false) }}
    </section>

    {# Pager #}
    {% block dh_auditor_pager %}
        {{ pager.render(helper.namespaceToParam(entity), id, paginator, filters) }}
    {% endblock dh_auditor_pager %}

{% endblock dh_auditor_content %}
