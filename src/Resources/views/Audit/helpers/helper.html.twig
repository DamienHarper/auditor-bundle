{% macro dump(value, separator) %}
    {%- import _self as helper -%}
    {%- if value.label is defined -%}
        {%- if value.label is iterable -%}
            {%- for k, v in value.label -%}
                {{- k }}: {{ helper.dump(v) }}{{ separator|default('<br/>')|raw -}}
            {%- endfor -%}
        {%- else -%}
            {{- value.label -}}
        {%- endif -%}
    {%- elseif value is iterable -%}
        {%- for k, v in value -%}
            {{- k }}: {{ helper.dump(v) }}{{ separator|default('<br/>')|raw -}}
        {%- endfor -%}
    {%- elseif value is same as(true) -%}
        true
    {%- elseif value is same as(false) -%}
        false
    {%- elseif value is not null -%}
        {{- value -}}
    {%- endif -%}
{% endmacro dump %}

{% macro namespaceToParam(entity) %}
{{- entity|replace({'\\': '-'}) -}}
{% endmacro namespaceToParam %}

{% macro type_badge(type) %}
    {%- if type == 'insert' -%}
        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-emerald-100 text-emerald-700 dark:bg-emerald-900/30 dark:text-emerald-400">INSERT</span>
    {%- elseif type == 'update' -%}
        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400">UPDATE</span>
    {%- elseif type == 'remove' -%}
        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-rose-100 text-rose-700 dark:bg-rose-900/30 dark:text-rose-400">REMOVE</span>
    {%- elseif type == 'associate' -%}
        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400">LINK</span>
    {%- elseif type == 'dissociate' -%}
        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-rose-50 text-rose-600 dark:bg-rose-900/20 dark:text-rose-300">UNLINK</span>
    {%- else -%}
        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-400">{{ type|upper }}</span>
    {%- endif -%}
{% endmacro type_badge %}

{# Option A: Sparkline compact (pour affichage inline dans le header, max 40% de largeur) #}
{% macro activity_sparkline(data, rawData, days, dates = [], entity = null) %}
    <div class="relative z-10 flex items-end gap-px h-4 w-full max-w-[40%] shrink-0" title="{{ 'audit.activity_graph.period'|trans({'%days%': days}, 'auditor') }}">
        {{ _self.activity_bars(data, rawData, dates, entity) }}
    </div>
{% endmacro activity_sparkline %}

{# Option B: Sparkline en bas, pleine largeur de la card #}
{% macro activity_sparkline_bottom(data, rawData, days, dates = [], entity = null) %}
    {% set hasActivity = data|filter(v => v > 0)|length > 0 %}
    <div class="mt-2 pt-2 border-t border-slate-100 dark:border-slate-800">
        <div class="relative z-10 flex items-end gap-px h-5">
            {{ _self.activity_bars(data, rawData, dates, entity) }}
        </div>
        <div class="text-xs text-slate-500 dark:text-slate-400 mt-1">
            {% if hasActivity %}
                {{ 'audit.activity_graph.title'|trans(domain='auditor') }} · {{ 'audit.activity_graph.period'|trans({'%days%': days}, 'auditor') }}
            {% else %}
                {{ 'audit.activity_graph.title'|trans(domain='auditor') }} · {{ 'audit.activity_graph.no_activity'|trans(domain='auditor') }}
            {% endif %}
        </div>
    </div>
{% endmacro activity_sparkline_bottom %}

{% macro activity_bars(data, rawData, dates = [], entity = null) %}
    {% set hasActivity = data|filter(v => v > 0)|length > 0 %}
    {% for value in data %}
        {% set rawValue = rawData[loop.index0]|default(0) %}
        {% set date = dates[loop.index0]|default(null) %}
        {% set label = (date ? date ~ ' · ' : '') ~ 'audit.audit_details.events_count'|trans({'%count%': rawValue, '%formatted_count%': rawValue|number_format}, 'auditor') %}
        {% set height = hasActivity ? (value > 0 ? max(15, value) : 4) : 20 %}
        {% set color = hasActivity ? 'bg-slate-300 dark:bg-indigo-500' : 'bg-slate-200 dark:bg-slate-600' %}
        {% if entity is not null and date is not null %}
            <a href="{{ path('dh_auditor_show_entity_stream', {entity: _self.namespaceToParam(entity), date_from: date, date_to: date}) }}"
               class="group flex flex-1 items-end h-full rounded-sm" title="{{ label }}" aria-label="{{ label }}"
               data-audit-date="{{ date }}" data-audit-count="{{ rawValue }}">
                <span class="w-full rounded-sm transition-colors group-hover:bg-slate-400 dark:group-hover:bg-indigo-400 group-focus:bg-slate-400 dark:group-focus:bg-indigo-400 {{ color }}"
                      style="height: {{ height }}%"></span>
            </a>
        {% else %}
            <div class="flex-1 rounded-sm {{ color }}" style="height: {{ height }}%" title="{{ label }}"></div>
        {% endif %}
    {% endfor %}
{% endmacro activity_bars %}

{# Legacy: garde l'ancien macro pour compatibilité #}
{% macro activity_graph(data, rawData, days, layout, dates = [], entity = null) %}
    {% import _self as helper %}
    {% if layout|default('bottom') == 'inline' %}
        {{ helper.activity_sparkline(data, rawData, days, dates, entity) }}
    {% else %}
        {{ helper.activity_sparkline_bottom(data, rawData, days, dates, entity) }}
    {% endif %}
{% endmacro activity_graph %}
