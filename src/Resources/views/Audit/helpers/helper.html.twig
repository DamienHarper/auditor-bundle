{% macro dump(value, separator) %}
    {%- import _self as helper -%}
    {%- if value.label is defined -%}
        {%- if value.label is iterable -%}
            {%- for k, v in value.label -%}
                {{- k }}: {{ helper.dump(v) }}{{ separator|default('<br/>')|raw -}}
            {%- endfor -%}
        {%- else -%}
            {{- value.label -}}
        {%- endif -%}
    {%- elseif value is iterable -%}
        {%- for k, v in value -%}
            {{- k }}: {{ helper.dump(v) }}{{ separator|default('<br/>')|raw -}}
        {%- endfor -%}
    {%- elseif value is same as(true) -%}
        true
    {%- elseif value is same as(false) -%}
        false
    {%- elseif value is not null -%}
        {{- value -}}
    {%- endif -%}
{% endmacro dump %}

{% macro namespaceToParam(entity) %}
{{- entity|replace({'\\': '-'}) -}}
{% endmacro namespaceToParam %}

{#
  Author of an audit entry: links to the user's global timeline when the entry carries a usable
  blame_id, otherwise shows the recorded username (or "anonymous"). Users without a getId() method
  are recorded with an empty blame_id, which must not produce a link.
#}
{% macro blame(entry) %}
    {%- set user_id = entry.userId is null ? '' : entry.userId ~ '' -%}
    {%- if user_id != '' -%}
        <a href="{{ path('dh_auditor_show_user_stream', {id: user_id}) }}"
           class="dh:font-medium dh:hover:underline">{{ entry.username ?? user_id }}</a>
    {%- else -%}
        <span class="dh:font-medium">{{ entry.username ?? 'audit.audit_details.anonymous'|trans(domain='auditor') }}</span>
    {%- endif -%}
{% endmacro blame %}

{#
  Blame context of an audit entry (an import, a console command, a Messenger message…), stored in the
  "via" key of the blame JSON: its type and label, with its data in the tooltip.
#}
{% macro via(entry) %}
    {%- set via = entry.via -%}
    {%- if via is not null -%}
        <span class="dh:inline-flex dh:h-5 dh:items-center dh:rounded-full dh:px-2 dh:text-xs dh:font-medium dh:border dh:border-dh-border dh:text-dh-foreground"
              {% if via.data is defined and via.data is not empty %}title="{{ via.data|json_encode }}"{% endif %}>
            {{- 'audit.entry.via'|trans(domain='auditor') }} {{ via.type }}{% if via.label is defined and via.label is not empty %} · {{ via.label }}{% endif -%}
        </span>
    {%- endif -%}
{% endmacro via %}

{#- Type of an audit entry, in three meanings: creation (inserted), deletion (deleted), anything else (neutral) -#}
{% macro type_badge(type, snapshot = false) %}
    {%- if type == 'insert' and snapshot -%}
        <span class="dh:inline-flex dh:h-5 dh:items-center dh:rounded-full dh:px-2 dh:text-xs dh:font-medium dh:border dh:border-dh-border dh:text-dh-foreground">SNAPSHOT</span>
    {%- elseif type == 'insert' -%}
        <span class="dh:inline-flex dh:h-5 dh:items-center dh:rounded-full dh:px-2 dh:text-xs dh:font-medium dh:bg-dh-inserted dh:text-dh-inserted-foreground">INSERT</span>
    {%- elseif type == 'remove' -%}
        <span class="dh:inline-flex dh:h-5 dh:items-center dh:rounded-full dh:px-2 dh:text-xs dh:font-medium dh:bg-dh-deleted dh:text-dh-deleted-foreground">REMOVE</span>
    {%- elseif type == 'associate' -%}
        <span class="dh:inline-flex dh:h-5 dh:items-center dh:rounded-full dh:px-2 dh:text-xs dh:font-medium dh:bg-dh-muted dh:text-dh-foreground">LINK</span>
    {%- elseif type == 'dissociate' -%}
        <span class="dh:inline-flex dh:h-5 dh:items-center dh:rounded-full dh:px-2 dh:text-xs dh:font-medium dh:bg-dh-muted dh:text-dh-foreground">UNLINK</span>
    {%- else -%}
        <span class="dh:inline-flex dh:h-5 dh:items-center dh:rounded-full dh:px-2 dh:text-xs dh:font-medium dh:bg-dh-muted dh:text-dh-foreground">{{ type|upper }}</span>
    {%- endif -%}
{% endmacro type_badge %}

{# Option A: Sparkline compact (pour affichage inline dans le header, max 40% de largeur) #}
{% macro activity_sparkline(data, rawData, days, dates = [], entity = null) %}
    <div class="dh:relative dh:z-10 dh:flex dh:items-end dh:gap-px dh:h-4 dh:w-full dh:max-w-[40%] dh:shrink-0" title="{{ 'audit.activity_graph.period'|trans({'%days%': days}, 'auditor') }}">
        {{ _self.activity_bars(data, rawData, dates, entity) }}
    </div>
{% endmacro activity_sparkline %}

{# Option B: Sparkline en bas, pleine largeur de la card #}
{% macro activity_sparkline_bottom(data, rawData, days, dates = [], entity = null) %}
    {% set hasActivity = data|filter(v => v > 0)|length > 0 %}
    <div class="dh:mt-2 dh:pt-2 dh:border-t dh:border-dh-border">
        <div class="dh:relative dh:z-10 dh:flex dh:items-end dh:gap-px dh:h-5">
            {{ _self.activity_bars(data, rawData, dates, entity) }}
        </div>
        <div class="dh:text-xs dh:text-dh-muted-foreground dh:mt-1">
            {% if hasActivity %}
                {{ 'audit.activity_graph.title'|trans(domain='auditor') }} · {{ 'audit.activity_graph.period'|trans({'%days%': days}, 'auditor') }}
            {% else %}
                {{ 'audit.activity_graph.title'|trans(domain='auditor') }} · {{ 'audit.activity_graph.no_activity'|trans(domain='auditor') }}
            {% endif %}
        </div>
    </div>
{% endmacro activity_sparkline_bottom %}

{% macro activity_bars(data, rawData, dates = [], entity = null) %}
    {% set hasActivity = data|filter(v => v > 0)|length > 0 %}
    {% for value in data %}
        {% set rawValue = rawData[loop.index0]|default(0) %}
        {% set date = dates[loop.index0]|default(null) %}
        {% set label = (date ? date ~ ' · ' : '') ~ 'audit.history.actions_count'|trans({'%count%': rawValue}, 'auditor') %}
        {# Bar height in 5 % steps, rendered by the dh-auditor-bar-h-* classes of app.css (no style attribute: CSP) #}
        {% set height = hasActivity ? (value > 0 ? (max(15, value) / 5)|round * 5 : 5) : 20 %}
        {% set color = hasActivity ? 'dh:bg-dh-brand' : 'dh:bg-dh-muted' %}
        {% if entity is not null and date is not null %}
            <a href="{{ path('dh_auditor_show_entity_stream', {entity: _self.namespaceToParam(entity), date_from: date, date_to: date}) }}"
               class="dh:group dh:flex dh:flex-1 dh:items-end dh:h-full dh:rounded-sm" title="{{ label }}" aria-label="{{ label }}"
               data-audit-date="{{ date }}" data-audit-count="{{ rawValue }}">
                <span class="dh:w-full dh:rounded-sm dh:group-hover:bg-dh-brand-to dh:group-focus-visible:bg-dh-brand-to {{ color }} dh-auditor-bar-h-{{ height }}"></span>
            </a>
        {% else %}
            <div class="dh:flex-1 dh:rounded-sm {{ color }} dh-auditor-bar-h-{{ height }}" title="{{ label }}"></div>
        {% endif %}
    {% endfor %}
{% endmacro activity_bars %}

{# Legacy: garde l'ancien macro pour compatibilité #}
{% macro activity_graph(data, rawData, days, layout, dates = [], entity = null) %}
    {% import _self as helper %}
    {% if layout|default('bottom') == 'inline' %}
        {{ helper.activity_sparkline(data, rawData, days, dates, entity) }}
    {% else %}
        {{ helper.activity_sparkline_bottom(data, rawData, days, dates, entity) }}
    {% endif %}
{% endmacro activity_graph %}
