{% macro render(entity, id = null, paginator, filters = {}) %}
    {% set queryParams = {entity: entity, id: id} %}
    {% if filters.type is defined and filters.type %}
        {% set queryParams = queryParams|merge({type: filters.type}) %}
    {% endif %}
    {% if filters.user is defined and filters.user %}
        {% set queryParams = queryParams|merge({user: filters.user}) %}
    {% endif %}
    {% for name in ['field', 'date_from', 'date_to'] %}
        {% if filters[name] is defined and filters[name] %}
            {% set queryParams = queryParams|merge({(name): filters[name]}) %}
        {% endif %}
    {% endfor %}

    {{ _self.render_route('dh_auditor_show_entity_stream', queryParams, paginator) }}
{% endmacro render %}

{# Generic pager: links to `route` with `routeParams` plus the target page number. #}
{% macro render_route(route, routeParams, paginator) %}
    {% if paginator.haveToPaginate %}
        <div class="flex items-center justify-center gap-1 mt-4 pt-4 border-t border-dh-border">
            {# First page #}
            {% if paginator.currentPage > 1 %}
                <a href="{{ path(route, routeParams|merge({page: 1})) }}"
                   class="inline-flex items-center justify-center size-8 text-sm text-dh-muted-foreground hover:text-dh-foreground hover:bg-dh-accent rounded-lg transition-colors"
                   title="{{ 'audit.pager.first'|trans(domain='auditor') }}">
                    <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7m8 14l-7-7 7-7"/>
                    </svg>
                </a>
            {% else %}
                <span class="inline-flex items-center justify-center size-8 text-dh-muted-foreground opacity-50 cursor-not-allowed">
                    <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7m8 14l-7-7 7-7"/>
                    </svg>
                </span>
            {% endif %}

            {# Previous #}
            {% if paginator.hasPreviousPage %}
                <a href="{{ path(route, routeParams|merge({page: paginator.previousPage})) }}"
                   class="inline-flex items-center justify-center size-8 text-sm text-dh-muted-foreground hover:text-dh-foreground hover:bg-dh-accent rounded-lg transition-colors"
                   title="{{ 'audit.pager.previous'|trans(domain='auditor') }}">
                    <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                    </svg>
                </a>
            {% else %}
                <span class="inline-flex items-center justify-center size-8 text-dh-muted-foreground opacity-50 cursor-not-allowed">
                    <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                    </svg>
                </span>
            {% endif %}

            {# Page numbers #}
            {% set startPage = max(1, paginator.currentPage - 2) %}
            {% set endPage = min(paginator.numPages, paginator.currentPage + 2) %}

            {# Adjust range to always show 5 pages when possible #}
            {% if endPage - startPage < 4 %}
                {% if startPage == 1 %}
                    {% set endPage = min(paginator.numPages, startPage + 4) %}
                {% elseif endPage == paginator.numPages %}
                    {% set startPage = max(1, endPage - 4) %}
                {% endif %}
            {% endif %}

            {# Show ellipsis before if needed #}
            {% if startPage > 1 %}
                <span class="inline-flex items-center justify-center size-8 text-sm text-dh-muted-foreground">…</span>
            {% endif %}

            {% for page in startPage..endPage %}
                {% if page == paginator.currentPage %}
                    <span class="inline-flex items-center justify-center size-8 rounded-lg bg-dh-link text-sm font-medium text-dh-link-foreground">
                        {{ page }}
                    </span>
                {% else %}
                    <a href="{{ path(route, routeParams|merge({page: page})) }}"
                       class="inline-flex items-center justify-center size-8 text-sm text-dh-muted-foreground hover:text-dh-foreground hover:bg-dh-accent rounded-lg transition-colors">
                        {{ page }}
                    </a>
                {% endif %}
            {% endfor %}

            {# Show ellipsis after if needed #}
            {% if endPage < paginator.numPages %}
                <span class="inline-flex items-center justify-center size-8 text-sm text-dh-muted-foreground">…</span>
            {% endif %}

            {# Next #}
            {% if paginator.hasNextPage %}
                <a href="{{ path(route, routeParams|merge({page: paginator.nextPage})) }}"
                   class="inline-flex items-center justify-center size-8 text-sm text-dh-muted-foreground hover:text-dh-foreground hover:bg-dh-accent rounded-lg transition-colors"
                   title="{{ 'audit.pager.next'|trans(domain='auditor') }}">
                    <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                </a>
            {% else %}
                <span class="inline-flex items-center justify-center size-8 text-dh-muted-foreground opacity-50 cursor-not-allowed">
                    <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                </span>
            {% endif %}

            {# Last page #}
            {% if paginator.currentPage < paginator.numPages %}
                <a href="{{ path(route, routeParams|merge({page: paginator.numPages})) }}"
                   class="inline-flex items-center justify-center size-8 text-sm text-dh-muted-foreground hover:text-dh-foreground hover:bg-dh-accent rounded-lg transition-colors"
                   title="{{ 'audit.pager.last'|trans(domain='auditor') }}">
                    <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7"/>
                    </svg>
                </a>
            {% else %}
                <span class="inline-flex items-center justify-center size-8 text-dh-muted-foreground opacity-50 cursor-not-allowed">
                    <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7"/>
                    </svg>
                </span>
            {% endif %}
        </div>

        {# Page info text #}
        <div class="text-center mt-2 text-xs text-dh-muted-foreground">
            {{ 'audit.pager.page_info'|trans({'%current%': paginator.currentPage, '%total%': paginator.numPages}, 'auditor') }}
        </div>
    {% endif %}
{% endmacro render_route %}
