{% extends "@DHAuditor/layout.html.twig" %}

{% import '@DHAuditor/Audit/helpers/helper.html.twig' as helper %}

{% block dh_auditor_content %}
    <div class="mb-6 mt-4">
        <h1 class="text-2xl font-semibold tracking-tight">{{ 'audit.home.title'|trans(domain='auditor') }}</h1>
        <p class="text-sm text-dh-muted-foreground">{{ 'audit.home.subtitle'|trans(domain='auditor') }}</p>
    </div>

    <section class="rounded-xl border border-dh-border bg-dh-card p-4">
        <h2 class="text-sm font-semibold">{{ 'audit.home.recent_activity'|trans(domain='auditor') }}</h2>
        {% if activity is empty %}
            <p class="py-6 text-center text-sm text-dh-muted-foreground">{{ 'audit.history.no_actions'|trans(domain='auditor') }}</p>
        {% else %}
            <ol class="divide-y divide-dh-border">
                {% for row in activity %}
                    {{ include('@DHAuditor/History/_row.html.twig', {row: row, date_format: 'datetime', shorten: 1, details: false}, with_context = false) }}
                {% endfor %}
            </ol>
            <p class="mt-2 text-xs text-dh-muted-foreground">{{ 'audit.home.bulk_note'|trans(domain='auditor') }}</p>
        {% endif %}
    </section>

    <section class="mt-8">
        <div class="mb-3 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <h2 class="text-sm font-semibold">{{ 'audit.home.audited'|trans(domain='auditor') }}</h2>
            <select id="sort-entities"
                    aria-label="{{ 'audit.sort.label'|trans(domain='auditor') }}"
                    class="dh-auditor-control"
                    data-dh-auditor-sort>
                {% for option in sortOptions %}
                    <option value="{{ option.value }}" {% if sort == option.value %}selected{% endif %}>
                        {{ ('audit.sort.' ~ option.value)|trans(domain='auditor') }}
                    </option>
                {% endfor %}
            </select>
        </div>

        <div class="overflow-x-auto rounded-xl border border-dh-border bg-dh-card">
            <table class="w-full text-left text-sm">
                <thead class="bg-dh-muted/50 text-xs text-dh-muted-foreground">
                    <tr>
                        <th class="px-4 py-2 font-medium">{{ 'audit.home.entity'|trans(domain='auditor') }}</th>
                        <th class="px-4 py-2 text-right font-medium">{{ 'audit.home.actions'|trans(domain='auditor') }}</th>
                        {% if activityGraphEnabled %}<th class="hidden px-4 py-2 font-medium sm:table-cell">{{ 'audit.activity_graph.title'|trans(domain='auditor') }}</th>{% endif %}
                        <th class="px-4 py-2 font-medium">{{ 'audit.audit_details.last_activity'|trans(domain='auditor') }}</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-dh-border">
                    {% for entity, data in audited %}
                        <tr class="hover:bg-dh-accent/50" data-dh-auditor-entity="{{ entity }}">
                            <td class="px-4 py-2">
                                <a href="{{ path('dh_auditor_show_entity_stream', {entity: helper.namespaceToParam(entity)}) }}" class="font-medium hover:underline" title="{{ entity }}">{{ dh_auditor_entity_name(entity, 2) }}</a>
                                <div class="font-mono text-xs text-dh-muted-foreground">{{ entity }}</div>
                            </td>
                            <td class="px-4 py-2 text-right tabular-nums">{{ data.count|number_format }}</td>
                            {% if activityGraphEnabled %}
                                <td class="hidden px-4 py-2 sm:table-cell">
                                    {% if data.activityGraph is defined %}
                                        {{ helper.activity_sparkline(data.activityGraph, data.activityGraphRaw|default([]), activityGraphDays, data.activityGraphDates, entity) }}
                                    {% endif %}
                                </td>
                            {% endif %}
                            <td class="whitespace-nowrap px-4 py-2 text-dh-muted-foreground">{{ data.latest.createdAt|time_ago }}</td>
                        </tr>
                    {% else %}
                        <tr><td colspan="4" class="px-4 py-8 text-center text-dh-muted-foreground">{{ 'audit.home.no_audits'|trans(domain='auditor') }}</td></tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </section>
{% endblock dh_auditor_content %}
