{% import '@DHAuditor/Audit/helpers/helper.html.twig' as helper %}

{# Get entity label — schema v2: from diffSource; schema v1 legacy: from diffs.label #}
{% set entity_label = null %}
{% set diff_source = entry.diffSource %}
{% if diff_source is not null and diff_source.label is defined %}
    {% set entity_label = diff_source.label is iterable ? diff_source.label|join(', ') : diff_source.label %}
{% elseif entry.diffs.label is defined %}
    {% set entity_label = entry.diffs.label is iterable ? entry.diffs.label|join(', ') : entry.diffs.label %}
{% endif %}

{#
  Transaction ID display:
  - ULID (schema v2, 26 chars): show in full — it is short and human-readable.
  - SHA1 (schema v1, 40 hex chars): truncate to 10 chars like a short git hash.
  Any ID longer than 26 chars is treated as a SHA1.
#}
{% set tx_id = entry.transactionId %}
{% set tx_label = tx_id is not empty ? (tx_id|length > 26 ? (tx_id|slice(0, 10) ~ '…') : tx_id) : null %}

{% if entry.type == 'remove' %}
{# REMOVE entries: expandable only for schema v2 when a field snapshot was captured. #}
{% set remove_diffs = entry.diffs %}
{% set remove_has_snapshot = entry.schemaVersion >= 2 and remove_diffs|length > 0 %}
{% if remove_has_snapshot %}
<details class="group hover:bg-slate-50 dark:hover:bg-slate-800/50 transition">
    <summary class="flex flex-col px-4 py-3 cursor-pointer list-none">
{% else %}
<div class="flex flex-col px-4 py-3 hover:bg-slate-50 dark:hover:bg-slate-800/50 transition">
    <div class="flex flex-col">
{% endif %}
        {# First line: badge, entity link, label, action description, hash #}
        <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
            <div class="flex flex-1 basis-64 items-center gap-3 min-w-0">
                {# Type badge - fixed width for alignment #}
                <span class="shrink-0 sm:w-24">
                    {{ helper.type_badge(entry.type, entry.isSnapshot()) }}
                </span>

                {# Entity info #}
                <div class="flex items-center gap-2 min-w-0 text-sm">
                    {# Entity name + ID #}
                    <a href="{{ path('dh_auditor_show_entity_stream', {'entity': helper.namespaceToParam(entity), 'id': entry.objectId}) }}"
                       class="font-medium text-slate-900 dark:text-slate-100 hover:underline shrink-0"
                       title="{{ entity }}">
                        {{ entity|split('\\')|last }} #{{ entry.objectId }}
                    </a>

                    {# Entity label if available - smaller and italic #}
                    {% if entity_label %}
                        <span class="text-slate-500 dark:text-slate-400">·</span>
                        <span class="text-xs italic text-slate-500 dark:text-slate-400 truncate">{{ entity_label }}</span>
                    {% endif %}

                    {# Action description #}
                    <span class="text-slate-500 dark:text-slate-400">·</span>
                    <span class="text-xs text-slate-400 dark:text-slate-500 italic shrink-0">
                        {{ 'audit.entry.action_remove'|trans(domain='auditor') }}
                    </span>
                </div>
            </div>

            <div class="flex items-center gap-4 text-sm text-slate-500 dark:text-slate-400 shrink-0">
                {# Transaction ID #}
                {% if tx_label is not empty and hide_transaction is not defined %}
                    <a href="{{ path('dh_auditor_show_transaction_stream', {hash: tx_id}) }}"
                       class="font-mono text-xs text-slate-400 hover:underline transition"
                       title="{{ tx_id }}">
                        {{ tx_label }}
                    </a>
                {% endif %}

                {# Compare this object's revisions #}
                <a href="{{ path('dh_auditor_select_revisions', {entity: helper.namespaceToParam(entity), id: entry.objectId, selected: entry.id}) }}"
                   class="text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 transition"
                   title="{{ 'audit.revisions.icon_title'|trans(domain='auditor') }}"
                   aria-label="{{ 'audit.revisions.icon_title'|trans(domain='auditor') }}">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h10M7 7l3-3M7 7l3 3M17 17H7m10 0l-3-3m3 3l-3 3"/>
                    </svg>
                </a>
                {% if remove_has_snapshot %}
                    <svg class="w-4 h-4 text-slate-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                    </svg>
                {% else %}
                    <span class="w-4"></span>
                {% endif %}
            </div>
        </div>

        {# Second line: date, user/command, blame context, IP, firewall #}
        <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5 min-w-0 mt-1 ml-2 text-xs text-slate-500 dark:text-slate-400">
            <span>{{ entry.createdAt|format_datetime('full', 'short', timezone: false) }}</span>
            <span>·</span>
            <span>{{ 'audit.entry.by'|trans(domain='auditor') }}
                {{ helper.blame(entry) }}
            </span>
            {{ helper.via(entry) }}
            {% if entry.ip is not empty %}
                <span>·</span>
                <span class="font-mono">{{ entry.ip }}</span>
            {% endif %}
            {% if entry.userFirewall is not empty %}
                <span>·</span>
                <span class="italic">{{ entry.userFirewall }}</span>
            {% endif %}
        </div>
{% if remove_has_snapshot %}
    </summary>
    {# Deleted entity snapshot: show old values #}
    <div class="px-4 pb-4 pl-8">
        <table class="text-xs font-mono">
            {% for field, changeset in remove_diffs %}
                {{ _self.displayRemoveValue(field, changeset, not entry.isDeepDiff(field)) }}
            {% endfor %}
        </table>
        {{ _self.displayExtraData(entry.extraData) }}
    </div>
</details>
{% else %}
    </div>
</div>
{% endif %}
{% else %}
{# Other entry types are expandable #}
<details class="group hover:bg-slate-50 dark:hover:bg-slate-800/50 transition">
    <summary class="flex flex-col px-4 py-3 cursor-pointer list-none">
        {# First line: badge, entity link, label, action description, hash, chevron #}
        <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1">
            <div class="flex flex-1 basis-64 items-center gap-3 min-w-0">
                {# Type badge - fixed width for alignment #}
                <span class="shrink-0 sm:w-24">
                    {{ helper.type_badge(entry.type, entry.isSnapshot()) }}
                </span>

                {# Entity info #}
                <div class="flex items-center gap-2 min-w-0 text-sm">
                    {# Entity name + ID #}
                    <a href="{{ path('dh_auditor_show_entity_stream', {'entity': helper.namespaceToParam(entity), 'id': entry.objectId}) }}"
                       class="font-medium text-slate-900 dark:text-slate-100 hover:underline shrink-0"
                       title="{{ entity }}">
                        {{ entity|split('\\')|last }} #{{ entry.objectId }}
                    </a>

                    {# Entity label if available - smaller and italic #}
                    {% if entity_label %}
                        <span class="text-slate-500 dark:text-slate-400">·</span>
                        <span class="text-xs italic text-slate-500 dark:text-slate-400 truncate">{{ entity_label }}</span>
                    {% endif %}

                    {# Action description #}
                    <span class="text-slate-500 dark:text-slate-400">·</span>
                    <span class="text-slate-400 dark:text-slate-500 text-xs italic shrink-0">
                        {% if entry.type == 'insert' and entry.isSnapshot() %}
                            {{ 'audit.entry.action_snapshot'|trans(domain='auditor') }}
                        {% elseif entry.type == 'insert' %}
                            {{ 'audit.entry.action_insert'|trans(domain='auditor') }}
                        {% elseif entry.type == 'update' %}
                            {{ 'audit.entry.action_update'|trans(domain='auditor') }}
                        {% elseif entry.type == 'associate' %}
                            {{ 'audit.entry.action_associate'|trans(domain='auditor') }}
                        {% elseif entry.type == 'dissociate' %}
                            {{ 'audit.entry.action_dissociate'|trans(domain='auditor') }}
                        {% endif %}
                    </span>
                </div>
            </div>

            <div class="flex items-center gap-4 text-sm text-slate-500 dark:text-slate-400 shrink-0">
                {# Transaction ID #}
                {% if tx_label is not empty and hide_transaction is not defined %}
                    <a href="{{ path('dh_auditor_show_transaction_stream', {hash: tx_id}) }}"
                       class="font-mono text-xs text-slate-400 hover:underline transition"
                       title="{{ tx_id }}">
                        {{ tx_label }}
                    </a>
                {% endif %}

                {# Compare this object's revisions #}
                <a href="{{ path('dh_auditor_select_revisions', {entity: helper.namespaceToParam(entity), id: entry.objectId, selected: entry.id}) }}"
                   class="text-slate-400 hover:text-slate-700 dark:hover:text-slate-200 transition"
                   title="{{ 'audit.revisions.icon_title'|trans(domain='auditor') }}"
                   aria-label="{{ 'audit.revisions.icon_title'|trans(domain='auditor') }}">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h10M7 7l3-3M7 7l3 3M17 17H7m10 0l-3-3m3 3l-3 3"/>
                    </svg>
                </a>

                {# Chevron #}
                <svg class="w-4 h-4 text-slate-400 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
            </div>
        </div>

        {# Second line: date, user/command, blame context, IP, firewall #}
        <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5 min-w-0 mt-1 ml-2 text-xs text-slate-500 dark:text-slate-400">
            <span>{{ entry.createdAt|format_datetime('full', 'short', timezone: false) }}</span>
            <span>·</span>
            <span>{{ 'audit.entry.by'|trans(domain='auditor') }}
                {{ helper.blame(entry) }}
            </span>
            {{ helper.via(entry) }}
            {% if entry.ip is not empty %}
                <span>·</span>
                <span class="font-mono">{{ entry.ip }}</span>
            {% endif %}
            {% if entry.userFirewall is not empty %}
                <span>·</span>
                <span class="italic">{{ entry.userFirewall }}</span>
            {% endif %}
        </div>
    </summary>

    {# Details content - diffs #}
    {% if entry.type == 'insert' %}
        <div class="px-4 pb-4 pl-8">
            <table class="text-xs font-mono">
                {% set diffs = entry.diffs %}
                {% for field, changeset in diffs %}
                    {% if field != 'label' %}
                        {{ _self.displayInsertValue(field, changeset, not entry.isDeepDiff(field)) }}
                    {% endif %}
                {% endfor %}
            </table>
            {{ _self.displayExtraData(entry.extraData) }}
        </div>
    {% elseif entry.type == 'update' %}
        <div class="px-4 pb-4 pl-8">
            <table class="text-xs font-mono">
                {% set diffs = entry.diffs %}
                {% for field, changeset in diffs %}
                    {% if field != 'label' %}
                        {{ _self.displayUpdateDiff(field, changeset, not entry.isDeepDiff(field)) }}
                    {% endif %}
                {% endfor %}
            </table>
            {{ _self.displayExtraData(entry.extraData) }}
        </div>
    {% elseif entry.type == 'associate' %}
        <div class="px-4 pb-4 pl-8">
            <table class="text-xs font-mono">
                {% set diffs = entry.diffs %}
                {% if diffs.source is defined and diffs.target is defined %}
                    <tr>
                        <td class="pr-3 text-blue-600 dark:text-blue-400 break-words max-w-[45%]">
                            {{ _self.displayRelatedEntity(diffs.source) }}
                        </td>
                        <td class="px-2 text-slate-400">
                            <svg class="w-5 h-5" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><path opacity=".4" d=""/><path d="M497 441L601 337C610.4 327.6 610.4 312.4 601 303.1L497 199C487.6 189.6 472.4 189.6 463.1 199C453.8 208.4 453.7 223.6 463.1 232.9L526.1 295.9L114 295.9L177 232.9C186.4 223.5 186.4 208.3 177 199C167.6 189.7 152.4 189.6 143.1 199L39 303C29.6 312.4 29.6 327.6 39 336.9L143 441C152.4 450.4 167.6 450.4 176.9 441C186.2 431.6 186.3 416.4 176.9 407.1L113.9 344.1L526 344.1L463 407.1C453.6 416.5 453.6 431.7 463 441C472.4 450.3 487.6 450.4 496.9 441z"/></svg>
                        </td>
                        <td class="pl-3 text-blue-600 dark:text-blue-400 break-words max-w-[45%]">
                            {{ _self.displayRelatedEntity(diffs.target) }}
                        </td>
                    </tr>
                    {% if diffs.source.label is defined or diffs.target.label is defined %}
                        <tr class="text-xs italic text-slate-500 dark:text-slate-400">
                            <td class="pr-3 break-words max-w-[45%]">{{ diffs.source.label is iterable ? diffs.source.label|join(', ') : diffs.source.label|default('—') }}</td>
                            <td></td>
                            <td class="pl-3 break-words max-w-[45%]">{{ diffs.target.label is iterable ? diffs.target.label|join(', ') : diffs.target.label|default('—') }}</td>
                        </tr>
                    {% endif %}
                {% endif %}
            </table>
            {{ _self.displayExtraData(entry.extraData) }}
        </div>
    {% elseif entry.type == 'dissociate' %}
        <div class="px-4 pb-4 pl-8">
            <table class="text-xs font-mono">
                {% set diffs = entry.diffs %}
                {% if diffs.source is defined and diffs.target is defined %}
                    <tr>
                        <td class="pr-3 text-rose-600 dark:text-rose-400 break-words max-w-[45%]">
                            {{ _self.displayRelatedEntity(diffs.source) }}
                        </td>
                        <td class="px-2 text-slate-400">
                            <svg class="w-5 h-5" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 640"><path opacity=".4" d=""/><path d="M497 441L601 337C610.4 327.6 610.4 312.4 601 303.1L497 199C487.6 189.6 472.4 189.6 463.1 199C453.8 208.4 453.7 223.6 463.1 232.9L526.1 295.9L114 295.9L177 232.9C186.4 223.5 186.4 208.3 177 199C167.6 189.7 152.4 189.6 143.1 199L39 303C29.6 312.4 29.6 327.6 39 336.9L143 441C152.4 450.4 167.6 450.4 176.9 441C186.2 431.6 186.3 416.4 176.9 407.1L113.9 344.1L526 344.1L463 407.1C453.6 416.5 453.6 431.7 463 441C472.4 450.3 487.6 450.4 496.9 441z"/></svg>
                        </td>
                        <td class="pl-3 text-rose-600 dark:text-rose-400 break-words max-w-[45%]">
                            {{ _self.displayRelatedEntity(diffs.target) }}
                        </td>
                    </tr>
                    {% if diffs.source.label is defined or diffs.target.label is defined %}
                        <tr class="text-xs italic text-slate-500 dark:text-slate-400">
                            <td class="pr-3 break-words max-w-[45%]">{{ diffs.source.label is iterable ? diffs.source.label|join(', ') : diffs.source.label|default('—') }}</td>
                            <td></td>
                            <td class="pl-3 break-words max-w-[45%]">{{ diffs.target.label is iterable ? diffs.target.label|join(', ') : diffs.target.label|default('—') }}</td>
                        </tr>
                    {% endif %}
                {% endif %}
            </table>
            {{ _self.displayExtraData(entry.extraData) }}
        </div>
    {% endif %}
</details>
{% endif %}

{#
  Diff macros: is_leaf tells whether the changeset is an old/new pair (a field diff, or a leaf of a
  JSON deep diff). At the root of a changeset, pass "not entry.isDeepDiff(field)"; a JSON deep diff
  is then walked down to its leaves, recognised by dh_auditor_is_diff_leaf().
#}

{# Macro for INSERT: table row with field and value #}
{% macro displayInsertValue(field, changeset, is_leaf = true) %}
    {% import '@DHAuditor/Audit/helpers/helper.html.twig' as helper %}
    {% if is_leaf %}
        {% if changeset.new is defined %}
            <tr>
                <td class="pr-6 text-slate-500 dark:text-slate-400 break-words max-w-[25%]">{{ field }}</td>
                <td class="text-emerald-600 dark:text-emerald-400 break-words max-w-[70%]">{{ helper.dump(changeset.new) }}</td>
            </tr>
        {% endif %}
    {% elseif changeset is iterable %}
        {# JSON deep diff #}
        {% for json_field, json_changeset in changeset %}
            {{ _self.displayInsertValue(field ~ '.' ~ json_field, json_changeset, dh_auditor_is_diff_leaf(json_changeset)) }}
        {% endfor %}
    {% endif %}
{% endmacro %}

{# Macro for UPDATE: table row with field, old value, arrow, new value #}
{% macro displayUpdateDiff(field, changeset, is_leaf = true) %}
    {% import '@DHAuditor/Audit/helpers/helper.html.twig' as helper %}
    {% if is_leaf %}
        {% if changeset.old is defined or changeset.new is defined %}
            <tr>
                <td class="pr-6 text-slate-500 dark:text-slate-400 break-words max-w-[20%]">{{ field }}</td>
                <td class="pr-3 text-slate-400 dark:text-slate-500 break-words max-w-[25%]">
                    {% if changeset.old is defined and changeset.old is not null %}
                        {{ helper.dump(changeset.old) }}
                    {% else %}
                        ⌀
                    {% endif %}
                </td>
                <td class="px-2 text-slate-400 dark:text-slate-500 whitespace-nowrap">→</td>
                <td class="pl-3 text-indigo-600 dark:text-indigo-400 break-words max-w-[40%]">
                    {% if changeset.new is defined and changeset.new is not null %}
                        {{ helper.dump(changeset.new) }}
                    {% else %}
                        ⌀
                    {% endif %}
                </td>
            </tr>
        {% endif %}
    {% elseif changeset is iterable %}
        {# JSON deep diff #}
        {% for json_field, json_changeset in changeset %}
            {{ _self.displayUpdateDiff(field ~ '.' ~ json_field, json_changeset, dh_auditor_is_diff_leaf(json_changeset)) }}
        {% endfor %}
    {% endif %}
{% endmacro %}

{# Macro for REMOVE snapshot: shows the old value (deleted entity state) #}
{% macro displayRemoveValue(field, changeset, is_leaf = true) %}
    {% import '@DHAuditor/Audit/helpers/helper.html.twig' as helper %}
    {% if is_leaf %}
        {% if changeset is iterable and changeset.old is defined %}
            <tr>
                <td class="pr-6 text-slate-500 dark:text-slate-400 break-words max-w-[25%]">{{ field }}</td>
                <td class="text-rose-600 dark:text-rose-400 break-words max-w-[70%]">
                    {% if changeset.old is not null %}
                        {{ helper.dump(changeset.old) }}
                    {% else %}
                        ⌀
                    {% endif %}
                </td>
            </tr>
        {% endif %}
    {% elseif changeset is iterable %}
        {# JSON deep diff #}
        {% for json_field, json_changeset in changeset %}
            {{ _self.displayRemoveValue(field ~ '.' ~ json_field, json_changeset, dh_auditor_is_diff_leaf(json_changeset)) }}
        {% endfor %}
    {% endif %}
{% endmacro %}

{# Macro for ASSOCIATE/DISSOCIATE: one side of the relation, linked to its audit stream when viewable #}
{# The provider stores the identifier under the primary key name, and adds "pkName" when that name is not "id" #}
{% macro displayRelatedEntity(summary) %}
    {% import '@DHAuditor/Audit/helpers/helper.html.twig' as helper %}
    {% set id = summary.pkName is defined ? summary[summary.pkName] : summary.id %}
    {% if dh_auditor_is_viewable(summary.class) %}
        <a href="{{ path('dh_auditor_show_entity_stream', { 'entity': helper.namespaceToParam(summary.class), 'id': id }) }}"
           class="hover:underline" title="{{ summary.class }}">
            {{ summary.class|split('\\')|last }} #{{ id }}
        </a>
    {% else %}
        <span title="{{ summary.class }}">
            {{ summary.class|split('\\')|last }} #{{ id }}
        </span>
    {% endif %}
{% endmacro %}

{# Macro for displaying extra_data #}
{% macro displayExtraData(extraData) %}
    {% import '@DHAuditor/Audit/helpers/helper.html.twig' as helper %}
    {% if extraData is not null and extraData is iterable and extraData|length > 0 %}
        <div class="mt-3 pt-3 border-t border-slate-200 dark:border-slate-700">
            <div class="flex items-center gap-2 mb-2">
                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <span class="text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wide">
                    {{ 'audit.entry.extra_data'|trans(domain='auditor') }}
                </span>
            </div>
            <table class="text-xs font-mono">
                {% for key, value in extraData %}
                    <tr>
                        <td class="pr-6 text-slate-500 dark:text-slate-400 break-words align-top max-w-[25%]">{{ key }}</td>
                        <td class="text-violet-600 dark:text-violet-400 break-words max-w-[70%]">{{ helper.dump(value) }}</td>
                    </tr>
                {% endfor %}
            </table>
        </div>
    {% endif %}
{% endmacro %}
