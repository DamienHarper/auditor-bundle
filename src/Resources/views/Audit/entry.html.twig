{#
  Macros of the diffs of an audit entry, imported by compare.html.twig. The streams render their actions with
  History/_row.html.twig.
#}

{#
  Diff macros: is_leaf tells whether the changeset is an old/new pair (a field diff, or a leaf of a
  JSON deep diff). At the root of a changeset, pass "not entry.isDeepDiff(field)"; a JSON deep diff
  is then walked down to its leaves, recognised by dh_auditor_is_diff_leaf().
#}

{# Macro for INSERT: table row with field and value #}
{% macro displayInsertValue(field, changeset, is_leaf = true) %}
    {% import '@DHAuditor/Audit/helpers/helper.html.twig' as helper %}
    {% if is_leaf %}
        {% if changeset.new is defined %}
            <tr>
                <td class="pr-6 text-slate-500 dark:text-slate-400 break-words max-w-[25%]">{{ field }}</td>
                <td class="text-emerald-600 dark:text-emerald-400 break-words max-w-[70%]">{{ helper.dump(changeset.new) }}</td>
            </tr>
        {% endif %}
    {% elseif changeset is iterable %}
        {# JSON deep diff #}
        {% for json_field, json_changeset in changeset %}
            {{ _self.displayInsertValue(field ~ '.' ~ json_field, json_changeset, dh_auditor_is_diff_leaf(json_changeset)) }}
        {% endfor %}
    {% endif %}
{% endmacro %}

{# Macro for UPDATE: table row with field, old value, arrow, new value #}
{% macro displayUpdateDiff(field, changeset, is_leaf = true) %}
    {% import '@DHAuditor/Audit/helpers/helper.html.twig' as helper %}
    {% if is_leaf %}
        {% if changeset.old is defined or changeset.new is defined %}
            <tr>
                <td class="pr-6 text-slate-500 dark:text-slate-400 break-words max-w-[20%]">{{ field }}</td>
                <td class="pr-3 text-slate-400 dark:text-slate-500 break-words max-w-[25%]">
                    {% if changeset.old is defined and changeset.old is not null %}
                        {{ helper.dump(changeset.old) }}
                    {% else %}
                        ⌀
                    {% endif %}
                </td>
                <td class="px-2 text-slate-400 dark:text-slate-500 whitespace-nowrap">→</td>
                <td class="pl-3 text-indigo-600 dark:text-indigo-400 break-words max-w-[40%]">
                    {% if changeset.new is defined and changeset.new is not null %}
                        {{ helper.dump(changeset.new) }}
                    {% else %}
                        ⌀
                    {% endif %}
                </td>
            </tr>
        {% endif %}
    {% elseif changeset is iterable %}
        {# JSON deep diff #}
        {% for json_field, json_changeset in changeset %}
            {{ _self.displayUpdateDiff(field ~ '.' ~ json_field, json_changeset, dh_auditor_is_diff_leaf(json_changeset)) }}
        {% endfor %}
    {% endif %}
{% endmacro %}

{# Macro for REMOVE snapshot: shows the old value (deleted entity state) #}
{% macro displayRemoveValue(field, changeset, is_leaf = true) %}
    {% import '@DHAuditor/Audit/helpers/helper.html.twig' as helper %}
    {% if is_leaf %}
        {% if changeset is iterable and changeset.old is defined %}
            <tr>
                <td class="pr-6 text-slate-500 dark:text-slate-400 break-words max-w-[25%]">{{ field }}</td>
                <td class="text-rose-600 dark:text-rose-400 break-words max-w-[70%]">
                    {% if changeset.old is not null %}
                        {{ helper.dump(changeset.old) }}
                    {% else %}
                        ⌀
                    {% endif %}
                </td>
            </tr>
        {% endif %}
    {% elseif changeset is iterable %}
        {# JSON deep diff #}
        {% for json_field, json_changeset in changeset %}
            {{ _self.displayRemoveValue(field ~ '.' ~ json_field, json_changeset, dh_auditor_is_diff_leaf(json_changeset)) }}
        {% endfor %}
    {% endif %}
{% endmacro %}

{# Macro for ASSOCIATE/DISSOCIATE: one side of the relation, linked to its audit stream when viewable #}
{# The provider stores the identifier under the primary key name, and adds "pkName" when that name is not "id" #}
{% macro displayRelatedEntity(summary) %}
    {% import '@DHAuditor/Audit/helpers/helper.html.twig' as helper %}
    {% set id = summary.pkName is defined ? summary[summary.pkName] : summary.id %}
    {% if dh_auditor_is_viewable(summary.class) %}
        <a href="{{ path('dh_auditor_show_entity_stream', { 'entity': helper.namespaceToParam(summary.class), 'id': id }) }}"
           class="hover:underline" title="{{ summary.class }}">
            {{ summary.class|split('\\')|last }} #{{ id }}
        </a>
    {% else %}
        <span title="{{ summary.class }}">
            {{ summary.class|split('\\')|last }} #{{ id }}
        </span>
    {% endif %}
{% endmacro %}

{# Macro for displaying extra_data #}
{% macro displayExtraData(extraData) %}
    {% import '@DHAuditor/Audit/helpers/helper.html.twig' as helper %}
    {% if extraData is not null and extraData is iterable and extraData|length > 0 %}
        <div class="mt-3 pt-3 border-t border-slate-200 dark:border-slate-700">
            <div class="flex items-center gap-2 mb-2">
                <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <span class="text-xs font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wide">
                    {{ 'audit.entry.extra_data'|trans(domain='auditor') }}
                </span>
            </div>
            <table class="text-xs font-mono">
                {% for key, value in extraData %}
                    <tr>
                        <td class="pr-6 text-slate-500 dark:text-slate-400 break-words align-top max-w-[25%]">{{ key }}</td>
                        <td class="text-violet-600 dark:text-violet-400 break-words max-w-[70%]">{{ helper.dump(value) }}</td>
                    </tr>
                {% endfor %}
            </table>
        </div>
    {% endif %}
{% endmacro %}
