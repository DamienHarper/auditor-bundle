{% extends "@DHAuditor/layout.html.twig" %}

{% import '@DHAuditor/Audit/helpers/helper.html.twig' as helper %}
{% import '@DHAuditor/Audit/entry.html.twig' as entry_macros %}

{% block dh_auditor_content %}
    {% set entity_param = helper.namespaceToParam(entity) %}

    {% block dh_auditor_header %}
    <div class="sticky top-16 z-40 -mx-6 px-6 py-3 mb-4 bg-slate-50/80 dark:bg-slate-950/80 backdrop-blur">
        {# Back link #}
        <a href="{{ path('dh_auditor_show_entity_stream', {entity: entity_param, id: id}) }}"
           class="inline-flex items-center text-sm text-slate-500 hover:text-slate-700 dark:text-slate-400 dark:hover:text-slate-200 mb-3">
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
            {{ entity|split('\\')|last }} #{{ id }}
        </a>

        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
            <h1 class="text-lg font-semibold text-slate-900 dark:text-slate-100" title="{{ entity }}">
                {{ 'audit.compare.title'|trans(domain='auditor') }}
            </h1>
            <a href="{{ path('dh_auditor_select_revisions', {entity: entity_param, id: id, selected: from.id}) }}"
               class="text-sm text-indigo-600 dark:text-indigo-400 hover:underline">
                {{ 'audit.compare.change_revisions'|trans(domain='auditor') }}
            </a>
        </div>
    </div>
    {% endblock dh_auditor_header %}

    {# The two compared revisions #}
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4 text-sm">
        {% for side in [{revision: from, title: 'audit.compare.before', step: previous, step_title: 'audit.compare.previous'}, {revision: to, title: 'audit.compare.after', step: next, step_title: 'audit.compare.next'}] %}
            <section class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 px-4 py-3" aria-labelledby="revision-{{ loop.index }}">
                <h2 id="revision-{{ loop.index }}" class="text-xs font-medium uppercase tracking-wide text-slate-400 dark:text-slate-500 mb-2">
                    {{ side.title|trans(domain='auditor') }}
                </h2>
                <div class="flex items-center gap-2">
                    {{ helper.type_badge(side.revision.type, side.revision.isSnapshot()) }}
                    <span class="font-medium text-slate-900 dark:text-slate-100">{{ side.revision.createdAt|format_datetime('full', 'short', timezone: false) }}</span>
                </div>
                <div class="mt-1 text-xs text-slate-500 dark:text-slate-400">
                    {{ side.revision.createdAt|time_ago }} · {{ 'audit.entry.by'|trans(domain='auditor') }} {{ helper.blame(side.revision) }} {{ helper.via(side.revision) }}
                </div>
                {% if side.step is not null %}
                    <a href="{{ path('dh_auditor_compare_revisions', {entity: entity_param, id: id, from: side.step.from, to: side.step.to}) }}"
                       class="inline-flex items-center gap-1 mt-2 text-xs text-indigo-600 dark:text-indigo-400 hover:underline">
                        {{ side.step_title|trans(domain='auditor') }}
                    </a>
                {% endif %}
            </section>
        {% endfor %}
    </div>

    {# Facts that a field-by-field comparison cannot show on its own #}
    {% set notices = [] %}
    {% if comparison.removed %}
        {% set notices = notices|merge([(comparison.recreated ? 'audit.compare.recreated' : 'audit.compare.removed')|trans(domain='auditor')]) %}
    {% endif %}
    {% if comparison.inconsistent is not empty %}
        {% set notices = notices|merge(['audit.compare.inconsistent'|trans({'%fields%': comparison.inconsistent|join(', ')}, 'auditor')]) %}
    {% endif %}
    {% if comparison.unreadable is not empty %}
        {% set notices = notices|merge(['audit.compare.unreadable'|trans({'%fields%': comparison.unreadable|join(', ')}, 'auditor')]) %}
    {% endif %}
    {% for notice in notices %}
        <p class="flex items-start gap-2 mb-4 rounded-lg border border-amber-200 dark:border-amber-900/50 bg-amber-50 dark:bg-amber-900/20 px-4 py-3 text-sm text-amber-800 dark:text-amber-300">
            <svg class="w-4 h-4 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span>{{ notice }}</span>
        </p>
    {% endfor %}

    <div class="rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-4">
        {% if comparison.fields is not empty %}
            <table class="w-full text-xs font-mono">
                <thead>
                    <tr class="text-slate-400 dark:text-slate-500 uppercase tracking-wide">
                        <th scope="col" class="pb-2 pr-6 text-left font-medium">{{ 'audit.audit_details.property'|trans(domain='auditor') }}</th>
                        <th scope="col" class="pb-2 pr-3 text-left font-medium">{{ 'audit.audit_details.old_value'|trans(domain='auditor') }}</th>
                        <td class="pb-2"></td>
                        <th scope="col" class="pb-2 pl-3 text-left font-medium">{{ 'audit.audit_details.new_value'|trans(domain='auditor') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for field, change in comparison.fields %}
                        {{ entry_macros.displayUpdateDiff(field, change) }}
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}

        {% if comparison.associations is not empty %}
            <table class="w-full text-xs font-mono{% if comparison.fields is not empty %} mt-4 pt-4 border-t border-slate-200 dark:border-slate-800{% endif %}">
                <caption class="pb-2 text-left text-slate-400 dark:text-slate-500 uppercase tracking-wide font-medium">
                    {{ 'audit.compare.associations'|trans(domain='auditor') }}
                </caption>
                <tbody>
                    {% for field, links in comparison.associations %}
                        {% for change in [{type: 'associate', targets: links.added}, {type: 'dissociate', targets: links.removed}] %}
                            {% for target in change.targets %}
                                <tr>
                                    <td class="py-1 pr-6 text-slate-500 dark:text-slate-400 break-words">{{ field }}</td>
                                    <td class="py-1 pr-3 whitespace-nowrap">{{ helper.type_badge(change.type) }}</td>
                                    <td class="py-1 text-slate-700 dark:text-slate-300 break-words">
                                        {{ entry_macros.displayRelatedEntity(target) }}
                                        {% if target.label is defined and target.label is not empty %}
                                            <span class="italic text-slate-500 dark:text-slate-400">· {{ target.label is iterable ? target.label|join(', ') : target.label }}</span>
                                        {% endif %}
                                    </td>
                                </tr>
                            {% endfor %}
                        {% endfor %}
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}

        {% if comparison.fields is empty and comparison.associations is empty %}
            <p class="p-8 text-center text-slate-500 dark:text-slate-400">
                {{ 'audit.compare.no_changes'|trans(domain='auditor') }}
            </p>
        {% endif %}
    </div>
{% endblock dh_auditor_content %}
