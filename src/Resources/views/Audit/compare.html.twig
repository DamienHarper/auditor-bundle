{% extends "@DHAuditor/layout.html.twig" %}

{% import '@DHAuditor/Audit/helpers/helper.html.twig' as helper %}
{% import '@DHAuditor/History/_macros.html.twig' as history %}

{% block dh_auditor_content %}
    {% set entity_param = helper.namespaceToParam(entity) %}

    {% block dh_auditor_header %}
    <div class="-mx-4 px-4 sm:-mx-6 sm:px-6 sm:sticky sm:top-16 sm:z-40 py-3 mb-4 bg-dh-background/80 backdrop-blur">
        {# Back link #}
        <a href="{{ path('dh_auditor_show_entity_stream', {entity: entity_param, id: id}) }}"
           class="inline-flex items-center text-sm text-dh-muted-foreground hover:text-dh-foreground mb-3">
            <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
            {{ entity|split('\\')|last }} #{{ id }}
        </a>

        <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
            <h1 class="text-2xl font-semibold tracking-tight text-dh-foreground" title="{{ entity }}">
                {{ 'audit.compare.title'|trans(domain='auditor') }}
            </h1>
            <a href="{{ path('dh_auditor_select_revisions', {entity: entity_param, id: id, selected: from.id}) }}"
               class="text-sm font-medium text-dh-foreground underline underline-offset-4 hover:decoration-2">
                {{ 'audit.compare.change_revisions'|trans(domain='auditor') }}
            </a>
        </div>
    </div>
    {% endblock dh_auditor_header %}

    {# The two compared revisions #}
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4 text-sm">
        {% for side in [{revision: from, title: 'audit.compare.before', step: previous, step_title: 'audit.compare.previous'}, {revision: to, title: 'audit.compare.after', step: next, step_title: 'audit.compare.next'}] %}
            <section class="rounded-xl border border-dh-border bg-dh-card px-4 py-3" aria-labelledby="revision-{{ loop.index }}">
                <h2 id="revision-{{ loop.index }}" class="text-xs font-medium uppercase tracking-wide text-dh-muted-foreground mb-2">
                    {{ side.title|trans(domain='auditor') }}
                </h2>
                <div class="flex items-center gap-2">
                    {{ helper.type_badge(side.revision.type, side.revision.isSnapshot()) }}
                    <span class="font-medium text-dh-foreground">{{ side.revision.createdAt|format_datetime('full', 'short', timezone: false) }}</span>
                </div>
                <div class="mt-1 text-xs text-dh-muted-foreground">
                    {{ side.revision.createdAt|time_ago }} · {{ 'audit.entry.by'|trans(domain='auditor') }} {{ helper.blame(side.revision) }} {{ helper.via(side.revision) }}
                </div>
                {% if side.step is not null %}
                    <a href="{{ path('dh_auditor_compare_revisions', {entity: entity_param, id: id, from: side.step.from, to: side.step.to}) }}"
                       class="inline-flex items-center gap-1 mt-2 text-xs font-medium text-dh-foreground underline underline-offset-4 hover:decoration-2">
                        {{ side.step_title|trans(domain='auditor') }}
                    </a>
                {% endif %}
            </section>
        {% endfor %}
    </div>

    {# Facts that a field-by-field comparison cannot show on its own #}
    {% set notices = [] %}
    {% if comparison.removed %}
        {% set notices = notices|merge([(comparison.recreated ? 'audit.compare.recreated' : 'audit.compare.removed')|trans(domain='auditor')]) %}
    {% endif %}
    {% if comparison.inconsistent is not empty %}
        {% set notices = notices|merge(['audit.compare.inconsistent'|trans({'%fields%': comparison.inconsistent|join(', ')}, 'auditor')]) %}
    {% endif %}
    {% if comparison.unreadable is not empty %}
        {% set notices = notices|merge(['audit.compare.unreadable'|trans({'%fields%': comparison.unreadable|join(', ')}, 'auditor')]) %}
    {% endif %}
    {% for notice in notices %}
        <p class="flex items-start gap-2 mb-4 rounded-lg border border-dh-warning-border bg-dh-warning px-4 py-3 text-sm text-dh-warning-foreground">
            <svg class="w-4 h-4 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span>{{ notice }}</span>
        </p>
    {% endfor %}

    {#- One way to read a change in the whole viewer: the Change column renders like the action details
        (History/_macros.html.twig, text_change). On a narrow screen, each field is stacked above its change. -#}
    <div class="overflow-hidden rounded-xl border border-dh-border bg-dh-card">
        {% if comparison.fields is not empty %}
            <table class="block w-full text-left text-xs text-dh-foreground sm:table sm:table-fixed">
                <colgroup>
                    <col class="w-1/4">
                    <col class="w-3/4">
                </colgroup>
                <thead class="block bg-dh-muted/50 text-dh-muted-foreground sm:table-header-group">
                    <tr class="flex sm:table-row">
                        <th scope="col" class="hidden px-3 py-2 font-medium sm:table-cell">{{ 'audit.history.field'|trans(domain='auditor') }}</th>
                        <th scope="col" class="px-3 py-2 font-medium">{{ 'audit.history.change'|trans(domain='auditor') }}</th>
                    </tr>
                </thead>
                <tbody class="block divide-y divide-dh-border sm:table-row-group">
                    {% for field, change in comparison.fields %}
                        <tr class="block py-1.5 align-top sm:table-row sm:py-0" data-field="{{ field }}">
                            <td class="block break-words px-3 py-0.5 sm:table-cell sm:py-2">
                                {{ '.' in field ? field : dh_auditor_field_label(entity, field) }}
                                <span class="ml-1 font-mono text-dh-muted-foreground">{{ field }}</span>
                            </td>
                            {#- a to-one relation is stored as a summary of the related object: show its label, as the action details do -#}
                            {% set old = change.old is iterable and change.old.label is defined ? change.old.label : change.old %}
                            {% set new = change.new is iterable and change.new.label is defined ? change.new.label : change.new %}
                            <td class="block px-3 py-0.5 sm:table-cell sm:py-2">{{ history.text_change(old, new) }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}

        {% if comparison.associations is not empty %}
            <div class="px-3 py-3 text-xs{% if comparison.fields is not empty %} border-t border-dh-border{% endif %}">
                <h2 class="font-medium uppercase tracking-wide text-dh-muted-foreground">{{ 'audit.compare.associations'|trans(domain='auditor') }}</h2>
                <ul class="mt-1.5 space-y-1 font-mono" data-dh-auditor-relations>
                    {% for field, links in comparison.associations %}
                        {% for change in [{type: 'associate', targets: links.added}, {type: 'dissociate', targets: links.removed}] %}
                            {% for target in change.targets %}
                                <li class="break-words">
                                    <span class="text-dh-muted-foreground">{{ field }}</span>
                                    {% if change.type == 'associate' %}<span class="text-dh-inserted-foreground">+</span>{% else %}<span class="text-dh-deleted-foreground">−</span>{% endif %}
                                    {{ history.related(target) }}
                                    {%- if target.label is defined and target.label is not empty %}
                                        <span class="text-dh-muted-foreground">· {{ target.label is iterable ? target.label|join(', ') : target.label }}</span>
                                    {%- endif %}
                                </li>
                            {% endfor %}
                        {% endfor %}
                    {% endfor %}
                </ul>
            </div>
        {% endif %}

        {% if comparison.fields is empty and comparison.associations is empty %}
            <p class="p-8 text-center text-sm text-dh-muted-foreground">
                {{ 'audit.compare.no_changes'|trans(domain='auditor') }}
            </p>
        {% endif %}
    </div>
{% endblock dh_auditor_content %}
