{
  "name": "damienharper/auditor-bundle",
  "type": "symfony-bundle",
  "description": "Symfony bundle for auditor: automatic Doctrine ORM audit logs, entity change history and an audit log viewer (formerly DoctrineAuditBundle).",
  "keywords": ["symfony", "symfony-bundle", "doctrine", "doctrine-orm", "audit", "auditor", "audit-log", "audit-trail", "auditing", "change-tracking", "entity-history", "history", "doctrine-audit-bundle"],
  "license": "MIT",
  "homepage": "https://damienharper.github.io/auditor-docs/auditor-bundle/",
  "support": {
    "docs": "https://damienharper.github.io/auditor-docs/auditor-bundle/",
    "issues": "https://github.com/DamienHarper/auditor-bundle/issues",
    "source": "https://github.com/DamienHarper/auditor-bundle"
  },
  "authors": [
    {
      "name": "Damien Harper",
      "email": "damien.harper@gmail.com"
    }
  ],
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "php": "^8.4",
    "ext-intl": "*",
    "damienharper/auditor": "^5.0@dev",
    "damienharper/auditor-doctrine-provider": "^2.0@dev",
    "doctrine/doctrine-bundle": "^3.0",
    "doctrine/dbal": "^4.0",
    "doctrine/orm": "^3.2",
    "symfony/asset": "^8.1",
    "symfony/doctrine-bridge": "^8.1",
    "symfony/event-dispatcher": "^8.1",
    "symfony/lock": "^8.1",
    "symfony/security-bundle": "^8.1",
    "symfony/translation": "^8.1",
    "symfony/twig-bundle": "^8.1",
    "twig/extra-bundle": "^3.3 || ^4.0",
    "twig/intl-extra": "^3.3 || ^4.0"
  },
  "autoload": {
    "psr-4": {
      "DH\\AuditorBundle\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "DH\\AuditorBundle\\Benchmarks\\": "benchmarks",
      "DH\\AuditorBundle\\Tests\\": "tests",
      "DH\\Auditor\\Tests\\": "vendor/damienharper/auditor-doctrine-provider/tests"
    }
  },
  "require-dev": {
    "dragonmantank/cron-expression": "^3.4",
    "gedmo/doctrine-extensions": "^3.0",
    "matthiasnoback/symfony-dependency-injection-test": "^6.0",
    "nyholm/symfony-bundle-test": "^3.0",
    "phpbench/phpbench": "^1.4",
    "phpunit/phpunit": "^13.4",
    "symfony/asset-mapper": "^8.1",
    "symfony/browser-kit": "^8.1",
    "symfony/css-selector": "^8.1",
    "symfony/framework-bundle": "^8.1",
    "symfony/messenger": "^8.1",
    "symfony/scheduler": "^8.1",
    "symfony/ux-twig-component": "^2.30",
    "symfony/validator": "^8.1",
    "symfony/var-dumper": "^8.1",
    "symfonycasts/tailwind-bundle": "^1.0"
  },
  "scripts": {
    "bench": "vendor/bin/phpbench run benchmarks/UserFilterBench.php --report=aggregate",
    "test": "./vendor/bin/phpunit --colors=always --no-coverage",
    "test:coverage": "XDEBUG_MODE=coverage ./vendor/bin/phpunit --colors=always",
    "testdox": "./vendor/bin/phpunit --colors=always --testdox --no-coverage",
    "cs-fix": "tools/php-cs-fixer/vendor/bin/php-cs-fixer fix --using-cache=no --verbose --ansi --allow-unsupported-php-version=yes",
    "cs-check": "tools/php-cs-fixer/vendor/bin/php-cs-fixer fix --using-cache=no --verbose --ansi --dry-run --allow-unsupported-php-version=yes",
    "phpstan": "tools/phpstan/vendor/bin/phpstan --memory-limit=1G --ansi analyse",
    "rector": "tools/rector/vendor/bin/rector",
    "rector-check": "tools/rector/vendor/bin/rector --dry-run",
    "agent-cs-fix": "tools/php-cs-fixer/vendor/bin/php-cs-fixer fix --using-cache=no --quiet --allow-unsupported-php-version=yes",
    "agent-phpstan": "tools/phpstan/vendor/bin/phpstan --memory-limit=1G --no-progress analyse",
    "agent-rector": "tools/rector/vendor/bin/rector --no-progress-bar",
    "agent-test": "./vendor/bin/phpunit --no-coverage --no-progress",
    "agent-qa": [
      "@agent-rector",
      "@agent-cs-fix",
      "@agent-phpstan"
    ],
    "qa": [
      "@rector",
      "@cs-fix",
      "@phpstan"
    ],
    "update-tools": "composer update --working-dir=tools/php-cs-fixer ; composer update --working-dir=tools/phpstan ; composer update --working-dir=tools/rector",
    "setup": "composer update --prefer-stable && rm -rf tests/App/var/cache/*"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "composer/package-versions-deprecated": true
    },
    "preferred-install": {
      "damienharper/*": "source",
      "*": "dist"
    }
  },
  "suggest": {
    "symfony/cache": "Required for activity graph caching in the audit viewer",
    "symfony/scheduler": "Required for scheduled audit logs pruning (providers.doctrine.retention.schedule)",
    "dragonmantank/cron-expression": "Required for scheduled audit logs pruning (cron expressions)",
    "symfony/ux-twig-component": "Required for the <twig:DhAuditor:History> component in the host application"
  },
  "extra": {
    "branch-alias": {
      "dev-master": "8.x-dev",
      "dev-7.x": "7.x-dev",
      "dev-6.x": "6.x-dev",
      "dev-5.x": "5.x-dev",
      "dev-4.x": "4.x-dev"
    }
  }
}
