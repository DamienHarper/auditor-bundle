parameters:
    level: max
    inferPrivatePropertyTypeFromConstructor: true

    type_coverage:
        return_type: 100
        param_type: 97
        property_type: 100
        constant: 0

    paths:
        - src

    ignoreErrors:
        - identifier: missingType.iterableValue
        # used by the tests of the applications (and tests/Test/), which PHPStan does not analyse
        -
            identifier: trait.unused
            path: src/Test/AuditAssertionsTrait.php
        -
            message: '~Cannot access offset .+ on mixed~'
            path: src/DHAuditorBundle.php
